---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db, publications } from "../../db";
import { asc } from "drizzle-orm";

const pubRows = await db.select().from(publications).orderBy(asc(publications.order));
---

<AdminLayout title="Publications">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Publications ({pubRows.length})</h1>
    <button onclick="document.getElementById('add-form').classList.toggle('hidden')" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm">+ Add Publication</button>
  </div>

  <div id="add-form" class="hidden mb-6 p-4 rounded-xl border border-cyan-400/30 bg-cyan-400/5">
    <h2 class="text-lg font-semibold mb-4">New Publication</h2>
    <form id="create-form" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
          <label class="block text-sm text-gray-400 mb-1">Title</label>
          <input type="text" name="title" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Venue</label>
          <input type="text" name="venue" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="arXiv, IEEE, ..." />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Date</label>
          <input type="date" name="date" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-sm text-gray-400 mb-1">URL</label>
          <input type="url" name="url" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="https://arxiv.org/abs/..." />
        </div>
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Order</label>
        <input type="number" name="order" value="0" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Description (Abstract)</label>
        <textarea name="description" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400"></textarea>
      </div>
      <div class="flex gap-3">
        <button type="submit" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm">Save</button>
        <button type="button" onclick="document.getElementById('add-form').classList.add('hidden')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors text-sm">Cancel</button>
      </div>
    </form>
  </div>

  <div class="space-y-3 max-w-3xl">
    {pubRows.map((p) => (
      <div class="p-4 rounded-xl border border-white/10 bg-white/5 group">
        <div class="flex justify-between items-start">
          <div class="flex-1">
            <h3 class="font-semibold">{p.title}</h3>
            {p.venue && <p class="text-cyan-400 text-sm">{p.venue}</p>}
            <p class="text-gray-500 text-xs mt-1">{p.date}</p>
            {p.description && <p class="text-gray-300 text-sm mt-2 line-clamp-2">{p.description}</p>}
          </div>
          <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
            <button data-edit={JSON.stringify(p)} class="px-3 py-1 bg-yellow-500/20 text-yellow-400 rounded text-xs hover:bg-yellow-500/30">Edit</button>
            <button data-delete={p.id} class="px-3 py-1 bg-red-500/20 text-red-400 rounded text-xs hover:bg-red-500/30">Delete</button>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div id="edit-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4">
    <div class="bg-[#111] border border-white/10 rounded-xl p-6 w-full max-w-lg">
      <h2 class="text-lg font-semibold mb-4">Edit Publication</h2>
      <form id="edit-form" class="space-y-4">
        <input type="hidden" name="id" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-sm text-gray-400 mb-1">Title</label>
            <input type="text" name="title" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Venue</label>
            <input type="text" name="venue" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Date</label>
            <input type="date" name="date" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-sm text-gray-400 mb-1">URL</label>
            <input type="url" name="url" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Order</label>
          <input type="number" name="order" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Description</label>
          <textarea name="description" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400"></textarea>
        </div>
        <div class="flex gap-3">
          <button type="submit" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm">Update</button>
          <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors text-sm">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  function toast(msg: string, ok = true) {
    const el = document.createElement("div");
    el.className = `fixed top-4 right-4 px-4 py-2 rounded-lg text-sm z-50 ${ok ? "bg-green-500/20 text-green-400 border border-green-500/30" : "bg-red-500/20 text-red-400 border border-red-500/30"}`;
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 3000);
  }

  document.getElementById("create-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data: Record<string, any> = Object.fromEntries(new FormData(form).entries());
    data.order = Number(data.order) || 0;
    const res = await fetch("/api/admin/publications", {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data),
    });
    if (res.ok) { toast("Created!"); setTimeout(() => location.reload(), 500); }
    else { toast("Failed", false); }
  });

  document.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const editBtn = target.closest("[data-edit]") as HTMLElement;
    if (editBtn) {
      try {
        const pub = JSON.parse(editBtn.dataset.edit || "{}");
        const modal = document.getElementById("edit-modal")!;
        const form = document.getElementById("edit-form") as HTMLFormElement;
        (form.querySelector("[name='id']") as HTMLInputElement).value = String(pub.id);
        (form.querySelector("[name='title']") as HTMLInputElement).value = pub.title || "";
        (form.querySelector("[name='venue']") as HTMLInputElement).value = pub.venue || "";
        (form.querySelector("[name='date']") as HTMLInputElement).value = pub.date?.split('T')[0] || pub.date || "";
        (form.querySelector("[name='url']") as HTMLInputElement).value = pub.url || "";
        (form.querySelector("[name='order']") as HTMLInputElement).value = String(pub.order ?? 0);
        (form.querySelector("[name='description']") as HTMLTextAreaElement).value = pub.description || "";
        modal.classList.remove("hidden");
      } catch (err) {
        console.error("Parse edit data error:", err);
      }
      return;
    }

    const deleteBtn = target.closest("[data-delete]") as HTMLElement;
    if (deleteBtn) {
      const id = Number(deleteBtn.dataset.delete);
      if (!id || isNaN(id)) return;
      if (!confirm("Delete this publication?")) return;
      const res = await fetch("/api/admin/publications", {
        method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id }),
      });
      if (res.ok) { toast("Deleted!"); setTimeout(() => location.reload(), 500); }
      else { toast("Failed", false); }
    }
  });

  document.getElementById("edit-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data: Record<string, any> = Object.fromEntries(new FormData(form).entries());
    data.id = Number(data.id);
    data.order = Number(data.order) || 0;
    const res = await fetch("/api/admin/publications", {
      method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data),
    });
    if (res.ok) { toast("Updated!"); setTimeout(() => location.reload(), 500); }
    else { toast("Failed", false); }
  });
</script>