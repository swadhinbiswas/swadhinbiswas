---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db, projects, projectCategories } from "../../db";
import { asc } from "drizzle-orm";

const projRows = await db.select().from(projects).orderBy(asc(projects.order));
const catRows = await db.select().from(projectCategories).orderBy(asc(projectCategories.order));
---

<AdminLayout title="Projects">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Projects ({projRows.length})</h1>
    <button onclick="document.getElementById('add-form').classList.toggle('hidden')" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm">+ Add Project</button>
  </div>

  <!-- Add Form -->
  <div id="add-form" class="hidden mb-6 p-4 rounded-xl border border-cyan-400/30 bg-cyan-400/5">
    <h2 class="text-lg font-semibold mb-4">New Project</h2>
    <form id="create-form" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-400 mb-1">Name *</label>
          <input type="text" name="name" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Status</label>
          <select name="status" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400">
            <option value="Active">Active</option>
            <option value="Archived">Archived</option>
            <option value="Planning">Planning</option>
            <option value="In Development">In Development</option>
          </select>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Category</label>
          <select name="category" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400">
            {catRows.map((c) => <option value={c.slug}>{c.label}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">URL *</label>
          <input type="url" name="url" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">GitHub</label>
          <input type="url" name="github" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Demo URL</label>
          <input type="url" name="demoUrl" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Documentation URL</label>
          <input type="url" name="documentation" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Image URL</label>
          <input type="url" name="image" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="https://..." />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Project Date</label>
          <input type="date" name="projectDate" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Stars</label>
          <input type="number" name="stars" value="0" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Featured</label>
          <select name="featured" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Description *</label>
        <textarea name="description" rows="2" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400"></textarea>
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Tags (comma separated)</label>
        <input type="text" name="tags" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="python, react, docker" />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Content (Markdown)</label>
        <textarea name="content" rows="10" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder="Detailed project content in Markdown..."></textarea>
      </div>
      
      <!-- Enhanced Fields -->
      <div class="border-t border-white/10 pt-4 mt-4">
        <h3 class="text-sm font-semibold text-cyan-400 mb-3">Enhanced Fields</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-gray-400 mb-1">Tech Stack (comma separated)</label>
            <input type="text" name="techStack" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="TypeScript, Node.js, React" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Role</label>
            <input type="text" name="role" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="Full Stack Developer" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Duration</label>
            <input type="text" name="duration" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="6 months" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Team Size</label>
            <input type="number" name="teamSize" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="1" />
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-sm text-gray-400 mb-1">Metrics (JSON format)</label>
          <textarea name="metrics" rows="2" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder='{"users": "10K+", "uptime": "99.9%"}'></textarea>
        </div>
        <div class="mt-4">
          <label class="block text-sm text-gray-400 mb-1">Gallery URLs (comma separated)</label>
          <input type="text" name="gallery" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="https://img1.png, https://img2.png" />
        </div>
        <div class="mt-4">
          <label class="block text-sm text-gray-400 mb-1">Challenges (Markdown)</label>
          <textarea name="challenges" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder="Key challenges faced..."></textarea>
        </div>
        <div class="mt-4">
          <label class="block text-sm text-gray-400 mb-1">Outcomes (Markdown)</label>
          <textarea name="outcomes" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder="Project outcomes and results..."></textarea>
        </div>
        <div class="mt-4">
          <label class="block text-sm text-gray-400 mb-1">Lessons Learned (Markdown)</label>
          <textarea name="lessonsLearned" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder="Lessons learned from this project..."></textarea>
        </div>
      </div>
      
      <div class="flex gap-3">
        <button type="submit" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm">Save</button>
        <button type="button" onclick="document.getElementById('add-form').classList.add('hidden')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors text-sm">Cancel</button>
      </div>
    </form>
  </div>

  <!-- List -->
  <div class="space-y-3 max-w-3xl">
    {projRows.map((proj) => {
      let tags: string[] = [];
      try { tags = JSON.parse(proj.tags || "[]"); } catch {}
      return (
        <div class="p-4 rounded-xl border border-white/10 bg-white/5 group">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <h3 class="font-semibold">{proj.name}</h3>
                {proj.stars ? <span class="text-yellow-400 text-xs">★ {proj.stars}</span> : null}
                {proj.featured ? <span class="text-cyan-400 text-[10px] bg-cyan-400/10 px-1.5 py-0.5 rounded">Featured</span> : null}
                <span class="text-[10px] text-gray-400 bg-white/5 px-1.5 py-0.5 rounded">{catRows.find((c) => c.slug === (proj.category || "data-engineering"))?.label || proj.category}</span>
              </div>
              <p class="text-gray-300 text-sm mt-1">{proj.description}</p>
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-2">
                  {tags.map((t: string) => <span class="text-[10px] text-gray-400 bg-white/5 px-1.5 py-0.5 rounded">{t}</span>)}
                </div>
              )}
            </div>
            <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <button data-edit={JSON.stringify(proj)} class="px-3 py-1 bg-yellow-500/20 text-yellow-400 rounded text-xs hover:bg-yellow-500/30">Edit</button>
              <button data-delete={proj.id} class="px-3 py-1 bg-red-500/20 text-red-400 rounded text-xs hover:bg-red-500/30">Delete</button>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4">
    <div class="bg-[#111] border border-white/10 rounded-xl p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <h2 class="text-lg font-semibold mb-4">Edit Project</h2>
      <form id="edit-form" class="space-y-4">
        <input type="hidden" name="id" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-gray-400 mb-1">Name *</label>
            <input type="text" name="name" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Status</label>
          <select name="status" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400">
            <option value="Active">Active</option>
            <option value="Archived">Archived</option>
            <option value="Planning">Planning</option>
            <option value="In Development">In Development</option>
          </select>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Category</label>
          <select name="category" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400">
            {catRows.map((c) => <option value={c.slug}>{c.label}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">URL *</label>
          <input type="url" name="url" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
        </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">GitHub</label>
            <input type="url" name="github" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Demo URL</label>
            <input type="url" name="demoUrl" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Documentation URL</label>
            <input type="url" name="documentation" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Image URL</label>
            <input type="url" name="image" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="https://..." />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Project Date</label>
            <input type="date" name="projectDate" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Stars</label>
            <input type="number" name="stars" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Featured</label>
            <select name="featured" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400">
              <option value="true">Yes</option>
              <option value="false">No</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-gray-400 mb-1">Order</label>
            <input type="number" name="order" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" />
          </div>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Description *</label>
          <textarea name="description" rows="2" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400"></textarea>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Tags (comma separated)</label>
          <input type="text" name="tags" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="python, react, docker" />
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Content (Markdown)</label>
          <textarea name="content" rows="12" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder="Detailed project content in Markdown..."></textarea>
        </div>
        
        <!-- Enhanced Fields -->
        <div class="border-t border-white/10 pt-4 mt-4">
          <h3 class="text-sm font-semibold text-cyan-400 mb-3">Enhanced Fields</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm text-gray-400 mb-1">Tech Stack (comma separated)</label>
              <input type="text" name="techStack" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="TypeScript, Node.js, React" />
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-1">Role</label>
              <input type="text" name="role" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="Full Stack Developer" />
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-1">Duration</label>
              <input type="text" name="duration" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="6 months" />
            </div>
            <div>
              <label class="block text-sm text-gray-400 mb-1">Team Size</label>
              <input type="number" name="teamSize" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="1" />
            </div>
          </div>
          <div class="mt-4">
            <label class="block text-sm text-gray-400 mb-1">Metrics (JSON format)</label>
            <textarea name="metrics" rows="2" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder='{"users": "10K+", "uptime": "99.9%"}'></textarea>
          </div>
          <div class="mt-4">
            <label class="block text-sm text-gray-400 mb-1">Gallery URLs (comma separated)</label>
            <input type="text" name="gallery" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400" placeholder="https://img1.png, https://img2.png" />
          </div>
          <div class="mt-4">
            <label class="block text-sm text-gray-400 mb-1">Challenges (Markdown)</label>
            <textarea name="challenges" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder="Key challenges faced..."></textarea>
          </div>
          <div class="mt-4">
            <label class="block text-sm text-gray-400 mb-1">Outcomes (Markdown)</label>
            <textarea name="outcomes" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder="Project outcomes and results..."></textarea>
          </div>
          <div class="mt-4">
            <label class="block text-sm text-gray-400 mb-1">Lessons Learned (Markdown)</label>
            <textarea name="lessonsLearned" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 font-mono text-sm" placeholder="Lessons learned from this project..."></textarea>
          </div>
        </div>
        
        <div class="flex gap-3">
          <button type="submit" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm">Update</button>
          <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors text-sm">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  function toast(msg: string, ok = true) {
    const el = document.createElement("div");
    el.className = `fixed top-4 right-4 px-4 py-2 rounded-lg text-sm z-50 ${ok ? "bg-green-500/20 text-green-400 border border-green-500/30" : "bg-red-500/20 text-red-400 border border-red-500/30"}`;
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 3000);
  }

  document.getElementById("create-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data: Record<string, any> = Object.fromEntries(new FormData(form).entries());
    data.tags = data.tags?.split(",").map((t: string) => t.trim()).filter(Boolean) || [];
    data.featured = data.featured === "true";
    data.stars = Number(data.stars) || 0;
    data.order = Number(data.order) || 0;
    data.techStack = data.techStack?.split(",").map((t: string) => t.trim()).filter(Boolean) || [];
    data.gallery = data.gallery?.split(",").map((t: string) => t.trim()).filter(Boolean) || [];
    try { data.metrics = JSON.parse(data.metrics || "{}"); } catch { data.metrics = {}; }
    data.teamSize = Number(data.teamSize) || null;
    const res = await fetch("/api/admin/projects", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });
    if (res.ok) { toast("Created!"); setTimeout(() => location.reload(), 500); }
    else { toast("Failed", false); }
  });

  document.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const editBtn = target.closest("[data-edit]") as HTMLElement;
    if (editBtn) {
      try {
        const proj = JSON.parse(editBtn.dataset.edit || "{}");
        const modal = document.getElementById("edit-modal")!;
        const form = document.getElementById("edit-form") as HTMLFormElement;
        (form.querySelector("[name='id']") as HTMLInputElement).value = String(proj.id);
        (form.querySelector("[name='name']") as HTMLInputElement).value = proj.name ?? "";
        (form.querySelector("[name='description']") as HTMLTextAreaElement).value = proj.description || "";
        (form.querySelector("[name='url']") as HTMLInputElement).value = proj.url || "";
        (form.querySelector("[name='github']") as HTMLInputElement).value = proj.github || "";
        (form.querySelector("[name='stars']") as HTMLInputElement).value = String(proj.stars ?? 0);
        (form.querySelector("[name='status']") as HTMLSelectElement).value = proj.status || "Active";
        (form.querySelector("[name='category']") as HTMLSelectElement).value = proj.category || "data-engineering";
        (form.querySelector("[name='featured']") as HTMLSelectElement).value = proj.featured ? "true" : "false";
        try {
          const tags = typeof proj.tags === "string" ? JSON.parse(proj.tags) : (proj.tags || []);
          (form.querySelector("[name='tags']") as HTMLInputElement).value = Array.isArray(tags) ? tags.join(", ") : "";
        } catch { (form.querySelector("[name='tags']") as HTMLInputElement).value = ""; }
        (form.querySelector("[name='order']") as HTMLInputElement).value = String(proj.order ?? 0);
        (form.querySelector("[name='demoUrl']") as HTMLInputElement).value = proj.demoUrl || "";
        (form.querySelector("[name='documentation']") as HTMLInputElement).value = proj.documentation || "";
        (form.querySelector("[name='image']") as HTMLInputElement).value = proj.image || "";
        (form.querySelector("[name='projectDate']") as HTMLInputElement).value = proj.projectDate || "";
        try {
          const techStack = typeof proj.techStack === "string" ? JSON.parse(proj.techStack) : (proj.techStack || []);
          (form.querySelector("[name='techStack']") as HTMLInputElement).value = Array.isArray(techStack) ? techStack.join(", ") : "";
        } catch { (form.querySelector("[name='techStack']") as HTMLInputElement).value = ""; }
        (form.querySelector("[name='role']") as HTMLInputElement).value = proj.role || "";
        (form.querySelector("[name='duration']") as HTMLInputElement).value = proj.duration || "";
        (form.querySelector("[name='teamSize']") as HTMLInputElement).value = String(proj.teamSize || "");
        try {
          const metrics = typeof proj.metrics === "string" ? JSON.parse(proj.metrics) : (proj.metrics || {});
          (form.querySelector("[name='metrics']") as HTMLTextAreaElement).value = JSON.stringify(metrics, null, 2);
        } catch { (form.querySelector("[name='metrics']") as HTMLTextAreaElement).value = "{}"; }
        try {
          const gallery = typeof proj.gallery === "string" ? JSON.parse(proj.gallery) : (proj.gallery || []);
          (form.querySelector("[name='gallery']") as HTMLInputElement).value = Array.isArray(gallery) ? gallery.join(", ") : "";
        } catch { (form.querySelector("[name='gallery']") as HTMLInputElement).value = ""; }
        (form.querySelector("[name='challenges']") as HTMLTextAreaElement).value = proj.challenges || "";
        (form.querySelector("[name='outcomes']") as HTMLTextAreaElement).value = proj.outcomes || "";
        (form.querySelector("[name='lessonsLearned']") as HTMLTextAreaElement).value = proj.lessonsLearned || "";
        (form.querySelector("[name='content']") as HTMLTextAreaElement).value = proj.content || "";
        modal.classList.remove("hidden");
      } catch (err) {
        console.error("Parse edit data error:", err);
      }
      return;
    }

    const deleteBtn = target.closest("[data-delete]") as HTMLElement;
    if (deleteBtn) {
      const id = Number(deleteBtn.dataset.delete);
      if (!id || isNaN(id)) return;
      if (!confirm("Delete this project?")) return;
      const res = await fetch("/api/admin/projects", {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id }),
      });
      if (res.ok) { toast("Deleted!"); setTimeout(() => location.reload(), 500); }
      else { toast("Failed", false); }
    }
  });

  document.getElementById("edit-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data: Record<string, any> = Object.fromEntries(new FormData(form).entries());
    data.id = Number(data.id);
    data.order = Number(data.order) || 0;
    data.tags = data.tags?.split(",").map((t: string) => t.trim()).filter(Boolean) || [];
    data.featured = data.featured === "true";
    data.stars = Number(data.stars) || 0;
    data.techStack = data.techStack?.split(",").map((t: string) => t.trim()).filter(Boolean) || [];
    data.gallery = data.gallery?.split(",").map((t: string) => t.trim()).filter(Boolean) || [];
    try { data.metrics = JSON.parse(data.metrics || "{}"); } catch { data.metrics = {}; }
    data.teamSize = Number(data.teamSize) || null;
    const res = await fetch("/api/admin/projects", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });
    if (res.ok) { toast("Updated!"); setTimeout(() => location.reload(), 500); }
    else { toast("Failed", false); }
  });
</script>

