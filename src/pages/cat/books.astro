---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db, books } from "../../db";
import { asc } from "drizzle-orm";

const bookRows = await db.select().from(books).orderBy(asc(books.order));
---

<AdminLayout title="Books & Audiobooks">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold flex items-center gap-2">
        <svg class="w-6 h-6 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        <span>Technical Books & Audiobooks ({bookRows.length})</span>
      </h1>
      <p class="text-xs text-gray-400 mt-1">Manage books read, audiobooks listened, book poster covers, and architectural takeaways.</p>
    </div>
    <button onclick="document.getElementById('add-form').classList.toggle('hidden')" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm flex items-center gap-1.5">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>Add Book / Audiobook</span>
    </button>
  </div>

  <!-- Add Book Form -->
  <div id="add-form" class="hidden mb-6 p-5 rounded-xl border border-cyan-400/30 bg-cyan-400/5">
    <h2 class="text-lg font-semibold mb-4 text-cyan-300">Add New Book / Audiobook</h2>
    <form id="create-form" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Book Title *</label>
          <input type="text" name="title" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" placeholder="e.g. Designing Data-Intensive Applications" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Author(s) *</label>
          <input type="text" name="author" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" placeholder="e.g. Martin Kleppmann" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Format Type</label>
          <select name="type" class="w-full bg-[#111] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm">
            <option value="read">Book (Read)</option>
            <option value="listened">Audiobook (Listened)</option>
            <option value="both">Both (Read & Listened)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Category</label>
          <input type="text" name="category" value="Distributed Systems" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" placeholder="Distributed Systems, Database Internals..." />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Status</label>
          <select name="status" class="w-full bg-[#111] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm">
            <option value="completed">Completed</option>
            <option value="reading">Currently Reading</option>
            <option value="listening">Currently Listening</option>
            <option value="recommended">Highly Recommended</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Poster / Cover Image URL</label>
          <input type="url" name="cover" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" placeholder="https://covers.openlibrary.org/b/id/...-L.jpg or CDN link" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Reference / Publisher URL</label>
          <input type="url" name="url" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" placeholder="https://..." />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Rating (1 to 5)</label>
          <select name="rating" class="w-full bg-[#111] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm">
            <option value="5">5 / 5 (Exceptional)</option>
            <option value="4">4 / 5 (Strong Recommendation)</option>
            <option value="3">3 / 5 (Good)</option>
            <option value="2">2 / 5 (Fair)</option>
            <option value="1">1 / 5 (Basic)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Display Order</label>
          <input type="number" name="order" value="0" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" />
        </div>
      </div>

      <div>
        <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Key Architectural Insight & Commentary</label>
        <textarea name="takeaway" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" placeholder="Core insight, architectural lesson, or mental model gained from this book..."></textarea>
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" id="add-featured" name="featured" class="w-4 h-4 rounded accent-cyan-400" />
        <label for="add-featured" class="text-xs text-gray-300">Feature this book on prominent lists</label>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm">Save Book</button>
        <button type="button" onclick="document.getElementById('add-form').classList.add('hidden')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors text-sm">Cancel</button>
      </div>
    </form>
  </div>

  <!-- Book List -->
  <div class="space-y-4 max-w-4xl">
    {bookRows.map((item) => (
      <div class="p-5 rounded-xl border border-white/10 bg-white/5 group hover:border-white/20 transition-all">
        <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
          <div class="flex items-start gap-4 flex-1">
            <!-- Poster thumbnail -->
            {item.cover ? (
              <div class="w-16 sm:w-20 aspect-[2/3] rounded-lg overflow-hidden bg-black/40 border border-white/10 shrink-0 shadow">
                <img src={item.cover} alt={item.title} class="w-full h-full object-cover" />
              </div>
            ) : (
              <div class="p-3 rounded-lg bg-white/5 border border-white/10 text-cyan-400 shrink-0 mt-0.5">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
              </div>
            )}

            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class="text-xs font-mono uppercase px-2 py-0.5 rounded bg-cyan-400/10 text-cyan-300 border border-cyan-400/20">
                  {item.category || "Engineering"}
                </span>
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-white/10 text-gray-300">
                  {item.type === 'listened' ? "Audiobook" : item.type === 'both' ? "Read & Audio" : "Book"}
                </span>
                <span class="text-xs font-mono text-amber-400">
                  ★ {item.rating}/5
                </span>
              </div>

              <h3 class="font-bold text-base text-white tracking-tight">
                {item.title}
              </h3>
              <p class="text-gray-400 text-xs font-mono mt-0.5">by {item.author}</p>

              {item.takeaway && (
                <p class="text-gray-300 text-xs mt-2.5 bg-black/40 p-3 rounded-lg border border-white/5 leading-relaxed italic">
                  "{item.takeaway}"
                </p>
              )}

              {item.url && (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-[11px] text-cyan-400 hover:underline mt-2 inline-block font-mono">
                  {item.url} ↗
                </a>
              )}
            </div>
          </div>

          <div class="flex gap-2 opacity-80 group-hover:opacity-100 transition-opacity shrink-0">
            <button data-edit={JSON.stringify(item)} class="px-3 py-1 bg-yellow-500/20 text-yellow-400 rounded text-xs hover:bg-yellow-500/30">Edit</button>
            <button data-delete={item.id} class="px-3 py-1 bg-red-500/20 text-red-400 rounded text-xs hover:bg-red-500/30">Delete</button>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-[#111] border border-white/20 rounded-2xl p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <h2 class="text-lg font-semibold mb-4 text-cyan-300">Edit Book / Audiobook</h2>
      <form id="edit-form" class="space-y-4">
        <input type="hidden" name="id" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Book Title *</label>
            <input type="text" name="title" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" />
          </div>
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Author(s) *</label>
            <input type="text" name="author" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Format Type</label>
            <select name="type" class="w-full bg-[#111] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm">
              <option value="read">Book (Read)</option>
              <option value="listened">Audiobook (Listened)</option>
              <option value="both">Both (Read & Listened)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Category</label>
            <input type="text" name="category" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" />
          </div>
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Status</label>
            <select name="status" class="w-full bg-[#111] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm">
              <option value="completed">Completed</option>
              <option value="reading">Currently Reading</option>
              <option value="listening">Currently Listening</option>
              <option value="recommended">Highly Recommended</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Poster / Cover Image URL</label>
            <input type="url" name="cover" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" placeholder="https://..." />
          </div>
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Reference URL</label>
            <input type="url" name="url" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Rating (1 to 5)</label>
            <select name="rating" class="w-full bg-[#111] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm">
              <option value="5">5 / 5 (Exceptional)</option>
              <option value="4">4 / 5 (Strong Recommendation)</option>
              <option value="3">3 / 5 (Good)</option>
              <option value="2">2 / 5 (Fair)</option>
              <option value="1">1 / 5 (Basic)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Display Order</label>
            <input type="number" name="order" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm" />
          </div>
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Key Architectural Insight & Commentary</label>
          <textarea name="takeaway" rows="3" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-cyan-400 text-sm"></textarea>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="edit-featured" name="featured" class="w-4 h-4 rounded accent-cyan-400" />
          <label for="edit-featured" class="text-xs text-gray-300">Feature this book on prominent lists</label>
        </div>

        <div class="flex gap-3 pt-2">
          <button type="submit" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold rounded-lg transition-colors text-sm">Update Book</button>
          <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors text-sm">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  // Add Form Submit
  const createForm = document.getElementById("create-form") as HTMLFormElement;
  createForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(createForm);
    const data = {
      title: fd.get("title"),
      author: fd.get("author"),
      type: fd.get("type") || "read",
      category: fd.get("category") || "Distributed Systems",
      status: fd.get("status") || "completed",
      cover: fd.get("cover") || "",
      rating: parseInt(fd.get("rating") as string) || 5,
      url: fd.get("url") || "",
      takeaway: fd.get("takeaway") || "",
      featured: fd.get("featured") === "on",
      order: parseInt(fd.get("order") as string) || 0,
    };

    try {
      const res = await fetch("/api/admin/books", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert("Error: " + (result.error || "Failed to create"));
      }
    } catch {
      alert("Network error");
    }
  });

  // Edit Button Click
  document.querySelectorAll("[data-edit]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = JSON.parse(btn.getAttribute("data-edit") || "{}");
      const modal = document.getElementById("edit-modal");
      const form = document.getElementById("edit-form") as HTMLFormElement;
      if (!modal || !form) return;

      (form.querySelector('[name="id"]') as HTMLInputElement).value = item.id;
      (form.querySelector('[name="title"]') as HTMLInputElement).value = item.title || "";
      (form.querySelector('[name="author"]') as HTMLInputElement).value = item.author || "";
      (form.querySelector('[name="type"]') as HTMLSelectElement).value = item.type || "read";
      (form.querySelector('[name="category"]') as HTMLInputElement).value = item.category || "";
      (form.querySelector('[name="status"]') as HTMLSelectElement).value = item.status || "completed";
      (form.querySelector('[name="cover"]') as HTMLInputElement).value = item.cover || "";
      (form.querySelector('[name="rating"]') as HTMLSelectElement).value = (item.rating || 5).toString();
      (form.querySelector('[name="url"]') as HTMLInputElement).value = item.url || "";
      (form.querySelector('[name="takeaway"]') as HTMLTextAreaElement).value = item.takeaway || "";
      (form.querySelector('[name="order"]') as HTMLInputElement).value = (item.order || 0).toString();
      (form.querySelector('[name="featured"]') as HTMLInputElement).checked = Boolean(item.featured);

      modal.classList.remove("hidden");
    });
  });

  // Edit Form Submit
  const editForm = document.getElementById("edit-form") as HTMLFormElement;
  editForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(editForm);
    const data = {
      id: parseInt(fd.get("id") as string),
      title: fd.get("title"),
      author: fd.get("author"),
      type: fd.get("type") || "read",
      category: fd.get("category") || "Distributed Systems",
      status: fd.get("status") || "completed",
      cover: fd.get("cover") || "",
      rating: parseInt(fd.get("rating") as string) || 5,
      url: fd.get("url") || "",
      takeaway: fd.get("takeaway") || "",
      featured: fd.get("featured") === "on",
      order: parseInt(fd.get("order") as string) || 0,
    };

    try {
      const res = await fetch("/api/admin/books", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert("Error: " + (result.error || "Failed to update"));
      }
    } catch {
      alert("Network error");
    }
  });

  // Delete Click
  document.querySelectorAll("[data-delete]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = parseInt(btn.getAttribute("data-delete") || "0");
      if (!confirm("Are you sure you want to delete this book?")) return;

      try {
        const res = await fetch("/api/admin/books", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id }),
        });
        const result = await res.json();
        if (result.success) {
          window.location.reload();
        } else {
          alert("Error: " + (result.error || "Failed to delete"));
        }
      } catch {
        alert("Network error");
      }
    });
  });
</script>
