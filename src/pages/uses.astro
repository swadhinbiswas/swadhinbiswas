---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { getDynamicConfig } from "../lib/config";
import { getUses } from "../lib/loaders";
import JsonLd from "../components/seo/JsonLd.astro";
import { env } from "../lib/env";
import GithubGraph from "../components/home/GithubGraph";

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || env.siteUrl || "https://swadhin.cv").replace(/\/$/, "");
const author = siteConfig.author || "Swadhin Biswas";
const githubUrl = siteConfig.links?.github || "https://github.com/swadhinbiswas";
const githubUsername = githubUrl.split("/").pop() || "swadhinbiswas";

const usesRows = await getUses();
const grouped: Record<string, string[]> = {};
for (const row of usesRows as any[]) {
  (grouped[row.category] ||= []).push(row.item);
}
const tools = Object.entries(grouped).map(([category, items]) => ({ category, items }));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Uses", "item": `${siteUrl}/uses` }
      ]
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}/uses/#webpage`,
      "url": `${siteUrl}/uses`,
      "name": `Tools & Setup — ${author}`,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": { "@id": `${siteUrl}/#person` }
    }
  ]
};
---

<BaseLayout title="Uses" description={`The tools, technologies, and setups ${author} uses daily for building systems and writing code.`}>
  <JsonLd slot="head" schema={schema} />
  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <div class="reveal">
        <p class="text-eyebrow">Uses</p>
        <h1 class="text-display mt-3 text-3xl sm:text-4xl text-aurora">Tools & setup</h1>
        <p class="prose-mono mt-4 max-w-prose">
          A curated list of the tools, technologies, and setups I use daily. Every tool here has earned its place through daily use — no trend chasing.
        </p>
      </div>
    </div>
  </section>

  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16 space-y-10">
      {tools.length === 0 ? (
        <p class="text-sm text-[var(--color-fg-muted)] reveal">No tools configured yet.</p>
      ) : (
        tools.map((group) => (
          <div class="reveal">
            <p class="text-eyebrow">{group.category}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))
      )}
    </div>
  </section>

  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <div class="panel p-5 sm:p-6 reveal">
        <div class="flex items-center justify-between gap-3">
          <p class="text-eyebrow">GitHub Activity</p>
          {githubUrl && (
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-mono text-xs text-[var(--color-fg-subtle)] transition-colors hover:text-[var(--color-accent)]">
              @{githubUsername}
            </a>
          )}
        </div>
        <div class="mt-3">
          <GithubGraph username={githubUsername} client:visible />
        </div>
      </div>
    </div>
  </section>

  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <p class="text-eyebrow reveal">Philosophy</p>
      {siteConfig.usesPhilosophy ? (
        <div class="mt-4 prose-mono max-w-prose reveal reveal-delay-1">
          {siteConfig.usesPhilosophy.split("\n\n").filter(Boolean).map((p) => <p>{p}</p>)}
        </div>
      ) : (
        <p class="mt-4 text-sm text-[var(--color-fg-muted)] reveal">No philosophy set yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
