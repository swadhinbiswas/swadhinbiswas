---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDynamicConfig } from "../lib/config";
import { getBooks } from "../lib/loaders";
import JsonLd from "../components/seo/JsonLd.astro";
import { env } from "../lib/env";

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || env.siteUrl || "https://swadhin.cv").replace(/\/$/, "");
const author = siteConfig.author || "Swadhin Biswas";

const rawBooks = await getBooks();

const booksList = rawBooks.map((b) => ({
  id: b.id,
  title: b.title,
  author: b.author,
  type: b.type || "read",
  category: b.category || "Distributed Systems",
  status: b.status || "completed",
  rating: b.rating || 5,
  cover: b.cover || null,
  url: b.url || null,
  takeaway: b.takeaway || "",
  featured: b.featured,
  order: b.order || 0,
}));

// Unique categories for filter pills
const categories = [...new Set(booksList.map((b) => b.category).filter(Boolean))];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Bookshelf", "item": `${siteUrl}/books` }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": `${siteUrl}/books/#webpage`,
      "url": `${siteUrl}/books`,
      "name": `Technical Bookshelf & Audiobooks — ${author}`,
      "description": `A curated technical library and audiobooks on distributed systems, database internals, and software engineering read by ${author}.`,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": { "@id": `${siteUrl}/#person` }
    }
  ]
};
---

<BaseLayout
  title="The Bookshelf — Technical Reading & Audiobooks"
  description={`Curated technical reading list, database internals, distributed systems canon, and engineering takeaways by ${author}.`}
>
  <JsonLd slot="head" schema={schema} />

  <!-- Hero Section -->
  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <div class="reveal">
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-[var(--color-card-strong)] border border-[var(--color-edge)] text-[var(--color-fg)]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
          </span>
          <p class="text-eyebrow">Continuous Learning & Architectural Canon</p>
        </div>
        <h1 class="text-display text-3xl sm:text-4xl lg:text-5xl text-aurora">
          The Bookshelf
        </h1>
        <p class="prose-mono mt-4 max-w-2xl text-[var(--color-fg-muted)] leading-relaxed">
          Foundational books and technical audiobooks that shaped my mental models on distributed systems, storage engine internals, fault tolerance, and high-leverage engineering leadership.
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-b border-[var(--color-edge)] pb-4 reveal">
        <div class="flex flex-wrap items-center gap-1.5" id="bookshelf-filters">
          <button type="button" class="book-filter-pill active" data-book-tag="all">
            All Titles ({booksList.length})
          </button>
          <button type="button" class="book-filter-pill" data-book-tag="read">
            Books (Read)
          </button>
          <button type="button" class="book-filter-pill" data-book-tag="listened">
            Audiobooks (Listened)
          </button>
          {categories.map((cat) => (
            <button type="button" class="book-filter-pill" data-book-cat={cat}>
              {cat}
            </button>
          ))}
        </div>

        <span class="text-xs font-mono text-[var(--color-fg-subtle)]">
          {booksList.length} Curated Masterclasses
        </span>
      </div>
    </div>
  </section>

  <!-- Books Grid -->
  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <div class="grid grid-cols-1 gap-8" id="bookshelf-grid">
        {booksList.map((b) => (
          <article
            class="book-card-full panel p-6 sm:p-7 reveal transition-all duration-300 hover:border-[var(--color-edge-strong)]"
            data-book-item
            data-type={b.type}
            data-category={b.category}
          >
            <div class="flex flex-col md:flex-row items-start gap-6 sm:gap-8">
              <!-- Left: 3D Poster Cover Image -->
              <div class="shrink-0 w-full md:w-44 flex justify-center">
                <div class="book-poster-frame relative group/poster">
                  <div class="w-36 sm:w-44 aspect-[2/3] rounded-lg overflow-hidden bg-[var(--color-card-strong)] shadow-2xl border border-white/10 relative transition-transform duration-500 ease-out group-hover/poster:scale-[1.03] group-hover/poster:-translate-y-1">
                    {b.cover ? (
                      <img
                        src={b.cover}
                        alt={`${b.title} cover`}
                        loading="lazy"
                        decoding="async"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        class="w-full h-full object-cover"
                      />
                    ) : null}

                    <!-- Fallback Minimal Typographic Cover (Shown if no cover or on error) -->
                    <div class={`w-full h-full bg-gradient-to-br from-zinc-800 to-zinc-950 p-4 flex flex-col justify-between ${b.cover ? 'hidden' : 'flex'}`}>
                      <div class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        </svg>
                        <span class="text-[9px] font-mono uppercase tracking-wider text-zinc-400">Canonical</span>
                      </div>
                      <div>
                        <h4 class="text-xs font-bold text-white leading-snug line-clamp-3">{b.title}</h4>
                        <p class="text-[10px] font-mono text-zinc-400 mt-1">{b.author}</p>
                      </div>
                    </div>

                    <!-- Realistic spine shadow overlay -->
                    <div class="absolute inset-y-0 left-0 w-3 bg-gradient-to-r from-black/50 via-black/20 to-transparent pointer-events-none"></div>
                    <div class="absolute inset-0 ring-1 ring-inset ring-white/10 pointer-events-none rounded-lg"></div>
                  </div>
                </div>
              </div>

              <!-- Right: Detailed Content & Fancy Commentary -->
              <div class="flex-1 min-w-0 flex flex-col justify-between">
                <div>
                  <!-- Top Badges & Rating -->
                  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--color-edge)] pb-3 mb-3">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="inline-flex items-center gap-1 text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-[var(--color-card-strong)] border border-[var(--color-edge)] text-[var(--color-fg)]">
                        {b.type === 'listened' ? (
                          <>
                            <svg class="w-3 h-3 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                              <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                            </svg>
                            <span>Audiobook</span>
                          </>
                        ) : b.type === 'both' ? (
                          <>
                            <svg class="w-3 h-3 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                              <path d="M12 6v6"/>
                            </svg>
                            <span>Read & Audio</span>
                          </>
                        ) : (
                          <>
                            <svg class="w-3 h-3 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                            </svg>
                            <span>Book</span>
                          </>
                        )}
                      </span>

                      <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[var(--color-card-strong)] border border-[var(--color-edge)] text-[var(--color-accent-2)]">
                        {b.category}
                      </span>
                    </div>

                    <!-- 5 Stars Rating -->
                    <div class="flex items-center gap-0.5 text-amber-400" title={`Rating: ${b.rating}/5`}>
                      {Array.from({ length: b.rating }).map(() => (
                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                      ))}
                    </div>
                  </div>

                  <!-- Book Title & Author -->
                  <h2 class="text-lg sm:text-xl font-bold text-[var(--color-fg)] tracking-tight">
                    {b.title}
                  </h2>
                  <p class="text-xs sm:text-sm font-mono text-[var(--color-fg-subtle)] mt-1">
                    by <span class="text-[var(--color-fg)] font-medium">{b.author}</span>
                  </p>

                  <!-- Fancy Editorial Commentary Box -->
                  {b.takeaway && (
                    <div class="mt-4 p-4 rounded-xl bg-[var(--color-card-strong)]/70 border border-[var(--color-edge)] relative overflow-hidden">
                      <div class="absolute top-2 right-3 text-3xl font-serif text-[var(--color-edge-strong)] select-none opacity-40 leading-none">
                        “
                      </div>
                      <div class="flex items-center gap-1.5 mb-1.5">
                        <span class="text-[10px] font-mono uppercase tracking-wider font-semibold text-[var(--color-accent-2)]">
                          Architectural Insight & Key Takeaway
                        </span>
                      </div>
                      <p class="text-xs sm:text-sm text-[var(--color-fg-muted)] leading-relaxed italic relative z-10">
                        "{b.takeaway}"
                      </p>
                    </div>
                  )}
                </div>

                <!-- Bottom Status & Link -->
                <div class="mt-5 pt-3 border-t border-[var(--color-edge)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
                  <div class="flex items-center gap-1.5 text-emerald-400">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span class="text-[11px] font-semibold uppercase tracking-wider">Completed</span>
                  </div>

                  {b.url && (
                    <a
                      href={b.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs font-mono font-medium px-3 py-1.5 rounded-lg bg-[var(--color-card-strong)] border border-[var(--color-edge)] text-[var(--color-fg)] hover:border-[var(--color-edge-strong)] flex items-center gap-1.5 transition-colors"
                    >
                      <span>Publisher & Reference</span>
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-link Callouts -->
  <section class="screen-line-after">
    <div class="container-narrow py-10 sm:py-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/workshop" class="panel p-5 group flex items-center justify-between hover:border-[var(--color-edge-strong)] transition-all">
          <div class="flex items-center gap-3">
            <span class="p-2.5 rounded-lg bg-[var(--color-card-strong)] border border-[var(--color-edge)] text-[var(--color-fg)]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
              </svg>
            </span>
            <div>
              <h4 class="text-sm font-bold text-[var(--color-fg)] group-hover:text-[var(--color-accent-2)] transition-colors">The Workshop</h4>
              <p class="text-[11px] text-[var(--color-fg-muted)]">Mechanical keyboards & homelab clusters</p>
            </div>
          </div>
          <span class="text-xs font-mono text-[var(--color-fg-subtle)] group-hover:translate-x-1 transition-transform">→</span>
        </a>

        <a href="/explore" class="panel p-5 group flex items-center justify-between hover:border-[var(--color-edge-strong)] transition-all">
          <div class="flex items-center gap-3">
            <span class="p-2.5 rounded-lg bg-[var(--color-card-strong)] border border-[var(--color-edge)] text-[var(--color-fg)]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
            </span>
            <div>
              <h4 class="text-sm font-bold text-[var(--color-fg)] group-hover:text-[var(--color-accent-2)] transition-colors">Explore Gallery</h4>
              <p class="text-[11px] text-[var(--color-fg-muted)]">Field photography & soundscapes</p>
            </div>
          </div>
          <span class="text-xs font-mono text-[var(--color-fg-subtle)] group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .book-filter-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    border: 1px solid transparent;
    color: var(--color-fg-subtle);
    background: transparent;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .book-filter-pill:hover {
    color: var(--color-fg);
    background: var(--color-card-strong);
  }
  .book-filter-pill.active {
    color: var(--color-fg);
    background: var(--color-card-strong);
    border-color: var(--color-edge);
    font-weight: 600;
  }
</style>

<script>
  const filterPills = document.querySelectorAll<HTMLButtonElement>('#bookshelf-filters button');
  const bookCards = document.querySelectorAll<HTMLElement>('[data-book-item]');

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');

      const tag = pill.getAttribute('data-book-tag');
      const cat = pill.getAttribute('data-book-cat');

      bookCards.forEach((card) => {
        const itemType = card.getAttribute('data-type');
        const itemCat = card.getAttribute('data-category');

        if (tag === 'all') {
          card.style.display = 'block';
        } else if (tag === 'read') {
          card.style.display = (itemType === 'read' || itemType === 'both') ? 'block' : 'none';
        } else if (tag === 'listened') {
          card.style.display = (itemType === 'listened' || itemType === 'both') ? 'block' : 'none';
        } else if (cat) {
          card.style.display = itemCat === cat ? 'block' : 'none';
        }
      });
    });
  });
</script>
