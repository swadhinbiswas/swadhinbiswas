---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDynamicConfig } from "../lib/config";
import { getBooks } from "../lib/loaders";
import JsonLd from "../components/seo/JsonLd.astro";
import { env } from "../lib/env";

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || env.siteUrl || "https://swadhin.cv").replace(/\/$/, "");
const author = siteConfig.author || "Swadhin Biswas";

const rawBooks = await getBooks();

const booksList = rawBooks.map((b) => ({
  id: b.id,
  title: b.title,
  author: b.author,
  type: b.type || "read",
  category: b.category || "Non-fiction",
  status: b.status || "completed",
  rating: b.rating || 5,
  cover: b.cover || null,
  url: b.url || null,
  takeaway: b.takeaway || "",
  featured: b.featured,
  order: b.order || 0,
}));

// Genres, in a deliberate reading order
const genreOrder = [
  "Engineering",
  "Non-fiction",
  "Bengali Classics",
  "Bengali Fiction",
  "Classics",
  "Fantasy",
  "Detective",
  "Adventure",
  "Science Fiction",
  "Poetry",
];
const genres = [...new Set(booksList.map((b) => b.category))]
  .sort((a, b) => {
    const ia = genreOrder.indexOf(a);
    const ib = genreOrder.indexOf(b);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  });
const countByGenre = booksList.reduce<Record<string, number>>((acc, b) => {
  acc[b.category] = (acc[b.category] || 0) + 1;
  return acc;
}, {});
const readCount = booksList.filter((b) => b.type === "read" || b.type === "both").length;
const audioCount = booksList.filter((b) => b.type === "listened" || b.type === "both").length;

// Bengali audio-story channels worth following
const channels = [
  {
    name: "Real Mir",
    url: "https://www.youtube.com/@realmir",
    tag: "Narration",
    desc: "Bengali story narration and audio fiction.",
  },
  {
    name: "Mirchi Bangla",
    url: "https://www.youtube.com/@MirchiBangla",
    tag: "Horror · Detective",
    desc: "Bengali audio stories — horror, detective and historical — plus Sunday Suspense.",
  },
  {
    name: "The Story Halt",
    url: "https://www.youtube.com/@TheStoryHalt",
    tag: "Detective · Adventure",
    desc: "Full-length Bengali audio stories, including detective and adventure serials.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Bookshelf", "item": `${siteUrl}/books` },
      ],
    },
    {
      "@type": "CollectionPage",
      "@id": `${siteUrl}/books/#webpage`,
      "url": `${siteUrl}/books`,
      "name": `The Bookshelf: Reading & Audiobooks | ${author}`,
      "description": `A curated shelf of engineering books, world classics and Bengali literature read by ${author}, with short takeaways.`,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": { "@id": `${siteUrl}/#person` },
    },
  ],
};
---

<BaseLayout
  title="The Bookshelf: Reading & Audiobooks"
  description={`Books and audiobooks I've read — engineering, world classics and Bengali literature — with short takeaways by ${author}.`}
>
  <JsonLd slot="head" schema={schema} />

  <!-- Hero -->
  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-14">
      <div class="reveal">
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-[var(--color-card-strong)] border border-[var(--color-edge)] text-[var(--color-fg)]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
          </span>
          <p class="text-eyebrow">Reading &amp; Audiobooks</p>
        </div>
        <h1 class="text-display text-3xl sm:text-4xl lg:text-5xl text-aurora">The Bookshelf</h1>
        <p class="prose-mono mt-4 max-w-2xl text-[var(--color-fg-muted)] leading-relaxed">
          Books that shaped how I think: engineering and data, world classics, and the Bengali fiction I grew up on. Hover a cover for the one-line takeaway.
        </p>
      </div>

      <!-- Filters -->
      <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-b border-[var(--color-edge)] pb-4 reveal">
        <div class="flex flex-wrap items-center gap-1.5" id="bookshelf-filters">
          <button type="button" class="book-filter-pill active" data-book-tag="all">
            All ({booksList.length})
          </button>
          <button type="button" class="book-filter-pill" data-book-tag="read">
            Books ({readCount})
          </button>
          <button type="button" class="book-filter-pill" data-book-tag="listened">
            Audio ({audioCount})
          </button>
          {genres.map((g) => (
            <button type="button" class="book-filter-pill" data-book-cat={g}>
              {g} ({countByGenre[g]})
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="screen-line-after">
    <div class="container-narrow py-10 sm:py-12">
      <div class="books-grid" id="bookshelf-grid">
        {booksList.map((b) => (
          <article
            class="book-tile reveal"
            data-book-item
            data-type={b.type}
            data-category={b.category}
          >
            <div class:list={["book-tile-cover", !b.cover && "no-cover"]}>
              {b.cover && (
                <img
                  src={b.cover}
                  alt={`${b.title} cover`}
                  loading="lazy"
                  decoding="async"
                  onerror="this.parentElement.classList.add('no-cover')"
                />
              )}
              <div class="book-tile-fallback">
                <svg class="book-tile-fallback-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                <span class="book-tile-fallback-title">{b.title}</span>
                <span class="book-tile-fallback-author">{b.author}</span>
              </div>
              {b.takeaway && <div class="book-tile-note">{b.takeaway}</div>}
            </div>
            <div class="book-tile-body">
              <h3 class="book-tile-title">
                {b.url ? (
                  <a href={b.url} target="_blank" rel="noopener noreferrer">{b.title}</a>
                ) : (
                  b.title
                )}
              </h3>
              <p class="book-tile-author">{b.author}</p>
              <div class="book-tile-meta">
                <span class="book-tile-stars" title={`${b.rating} / 5`}>
                  {"★".repeat(b.rating)}
                  <span class="book-tile-stars-dim">{"☆".repeat(5 - b.rating)}</span>
                </span>
                <span class="book-tile-genre">{b.category}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Listen: Bengali audio stories -->
  <section class="screen-line-after">
    <div class="container-narrow py-10 sm:py-12">
      <div class="reveal">
        <p class="text-eyebrow">Listen</p>
        <h2 class="panel-title mt-1">Bengali audio stories I follow</h2>
        <p class="prose-mono text-sm text-[var(--color-fg-muted)] mt-2 max-w-2xl">
          When I'd rather listen than read, these are the channels narrating Bengali fiction.
        </p>
      </div>
      <div class="channel-grid mt-6">
        {channels.map((c) => (
          <a href={c.url} target="_blank" rel="noopener noreferrer" class="channel-card reveal">
            <span class="channel-play" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <div class="channel-body">
              <div class="channel-head">
                <h3 class="channel-name">{c.name}</h3>
                <span class="channel-tag">{c.tag}</span>
              </div>
              <p class="channel-desc">{c.desc}</p>
              <span class="channel-link">Watch on YouTube →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-link -->
  <section class="screen-line-after">
    <div class="container-narrow py-10 sm:py-12">
      <div class="grid grid-cols-1 gap-4">
        <a href="/explore" class="panel p-5 group flex items-center justify-between hover:border-[var(--color-edge-strong)] transition-all">
          <div class="flex items-center gap-3">
            <span class="p-2.5 rounded-lg bg-[var(--color-card-strong)] border border-[var(--color-edge)] text-[var(--color-fg)]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
            </span>
            <div>
              <h4 class="text-sm font-bold text-[var(--color-fg)] group-hover:text-[var(--color-accent-2)] transition-colors">Explore Gallery</h4>
              <p class="text-[11px] text-[var(--color-fg-muted)]">Field photography &amp; soundscapes</p>
            </div>
          </div>
          <span class="text-xs font-mono text-[var(--color-fg-subtle)] group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .book-filter-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    border: 1px solid transparent;
    color: var(--color-fg-subtle);
    background: transparent;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .book-filter-pill:hover { color: var(--color-fg); background: var(--color-card-strong); }
  .book-filter-pill.active {
    color: var(--color-fg);
    background: var(--color-card-strong);
    border-color: var(--color-edge);
    font-weight: 600;
  }

  /* ── Compact grid ── */
  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: 1.5rem 1.15rem;
  }
  @media (max-width: 420px) {
    .books-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 0.9rem; }
  }

  .book-tile { display: flex; flex-direction: column; min-width: 0; }

  .book-tile-cover {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-card-strong);
    border: 1px solid var(--color-edge);
    box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.9);
    transition: transform 0.3s ease, border-color 0.25s ease;
  }
  .book-tile:hover .book-tile-cover { transform: translateY(-3px); border-color: var(--color-edge-strong); }
  .book-tile-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.35s ease;
  }
  .book-tile:hover .book-tile-cover img { filter: grayscale(0); }
  /* spine shadow */
  .book-tile-cover::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 9px;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.55), transparent);
    z-index: 2;
    pointer-events: none;
  }

  .book-tile-cover.no-cover img { display: none; }
  .book-tile-cover:not(.no-cover) .book-tile-fallback { display: none; }
  .book-tile-fallback {
    position: absolute;
    inset: 0;
    padding: 0.9rem 0.8rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    background: linear-gradient(150deg, #1b1b1f, #0b0b0d);
    color: #f2f2ef;
  }
  .book-tile-fallback-icon { color: #6b6b73; }
  .book-tile-fallback-title { font-size: 0.82rem; font-weight: 700; line-height: 1.3; }
  .book-tile-fallback-author { font-family: var(--font-mono); font-size: 0.62rem; color: #8b8b93; }

  /* hover takeaway */
  .book-tile-note {
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: 0.8rem;
    display: flex;
    align-items: center;
    background: rgba(8, 8, 10, 0.9);
    color: #ececec;
    font-size: 0.7rem;
    line-height: 1.5;
    opacity: 0;
    transition: opacity 0.25s ease;
    overflow: auto;
  }
  .book-tile:hover .book-tile-note { opacity: 1; }

  .book-tile-body { padding: 0.6rem 0.15rem 0; display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .book-tile-title { font-family: var(--font-display); font-size: 0.82rem; font-weight: 700; line-height: 1.3; color: var(--color-fg); }
  .book-tile-title a { color: inherit; text-decoration: none; }
  .book-tile-title a:hover { color: var(--color-accent-2); }
  .book-tile-author {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-fg-subtle);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .book-tile-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; margin-top: 0.15rem; }
  .book-tile-stars { font-size: 0.62rem; color: var(--color-accent-2); letter-spacing: 0.02em; }
  .book-tile-stars-dim { color: var(--color-edge-strong); }
  .book-tile-genre {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-subtle);
    border: 1px solid var(--color-edge);
    border-radius: 5px;
    padding: 0.1rem 0.35rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 60%;
  }

  /* ── Audio channels ── */
  .channel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 760px) { .channel-grid { grid-template-columns: repeat(3, 1fr); } }
  .channel-card {
    display: flex;
    gap: 0.9rem;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--color-edge);
    background: var(--color-card);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .channel-card:hover { border-color: var(--color-edge-strong); transform: translateY(-2px); }
  .channel-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid var(--color-edge-strong);
    background: var(--color-bg-2);
    color: var(--color-fg);
  }
  .channel-body { min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .channel-head { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .channel-name { font-family: var(--font-display); font-size: 0.98rem; font-weight: 700; color: var(--color-fg); }
  .channel-tag {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-subtle);
    border: 1px solid var(--color-edge);
    border-radius: 5px;
    padding: 0.1rem 0.35rem;
  }
  .channel-desc { font-size: 0.8rem; color: var(--color-fg-muted); line-height: 1.55; }
  .channel-link { font-family: var(--font-mono); font-size: 0.66rem; color: var(--color-accent-2); margin-top: 0.15rem; }
</style>

<script>
  const filterPills = document.querySelectorAll<HTMLButtonElement>('#bookshelf-filters button');
  const bookCards = document.querySelectorAll<HTMLElement>('[data-book-item]');

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      filterPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');

      const tag = pill.getAttribute('data-book-tag');
      const cat = pill.getAttribute('data-book-cat');

      bookCards.forEach((card) => {
        const itemType = card.getAttribute('data-type');
        const itemCat = card.getAttribute('data-category');

        let show = true;
        if (tag === 'read') show = itemType === 'read' || itemType === 'both';
        else if (tag === 'listened') show = itemType === 'listened' || itemType === 'both';
        else if (cat) show = itemCat === cat;

        card.style.display = show ? 'flex' : 'none';
      });
    });
  });
</script>
