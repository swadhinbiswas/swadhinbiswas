---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db, posts } from "../../db";
import { eq } from "drizzle-orm";
import { renderMarkdown } from "../../lib/markdown";
import "katex/dist/katex.min.css";
import "highlight.js/styles/github-dark.css";
import { getDynamicConfig } from "../../lib/config";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const siteConfig = await getDynamicConfig();
const blogOrigin = (siteConfig.blogUrl || "https://blog.swadhin.cv").replace(/\/$/, "");
const siteUrl = (siteConfig.url || "https://swadhin.cv").replace(/\/$/, "");

// 1. Local post from the admin dashboard?
let post: any = null;
try {
  const rows = await db.select().from(posts).where(eq(posts.slug, slug)).limit(1);
  post = rows[0] || null;
} catch {}

// 2. External link → 301 to the article
if (post?.externalUrl) return Astro.redirect(post.externalUrl, 301);

// 3. Not a local post → maybe it's a blog.swadhin.cv post
if (!post) return Astro.redirect(`${blogOrigin}/blog/${slug}/`, 301);

// 4. Local post with content → render it here
const { html: contentHtml, features } = await renderMarkdown(post.content || "");
const tags = (() => { try { return JSON.parse(post.tags || "[]"); } catch { return []; } })();
const canonicalUrl = `${siteUrl}/posts/${slug}/`;
const publishedIso = post.publishedAt instanceof Date ? post.publishedAt.toISOString() : new Date(post.publishedAt).toISOString();

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/posts` },
        { "@type": "ListItem", "position": 3, "name": post.title, "item": canonicalUrl },
      ],
    },
    {
      "@type": "BlogPosting",
      "@id": `${canonicalUrl}#article`,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
      headline: post.title,
      description: post.description,
      datePublished: publishedIso,
      author: { "@id": `${siteUrl}/#person` },
      publisher: { "@id": `${siteUrl}/#person` },
      keywords: tags,
    },
  ],
};

const formatDate = (date: any) =>
  new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout title={post.title} description={post.description} image={`${siteUrl}/api/og/posts/${slug}.svg`} ogType="article" canonical={`/posts/${slug}/`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <meta property="article:published_time" content={publishedIso} />
    {features.hasMermaid && <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js" />}
    {features.hasPlotly && <script src="https://cdn.jsdelivr.net/npm/plotly.js@3.3.1/dist/plotly.min.js" />}
    {features.hasCharts && <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js" />}
  </Fragment>

  <article>
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <a href="/posts" class="text-mono inline-flex items-center gap-1.5 text-xs text-[var(--color-fg-subtle)] transition-colors hover:text-[var(--color-accent)] reveal">
          ← All posts
        </a>
        <div class="mt-8 reveal reveal-delay-1">
          <p class="text-mono text-xs text-[var(--color-fg-subtle)]">{formatDate(post.publishedAt)}</p>
          <h1 class="text-display mt-3 text-3xl sm:text-4xl">
            <span class="text-aurora">{post.title}</span>
          </h1>
          {post.description && <p class="prose-mono mt-4 max-w-prose">{post.description}</p>}
          {tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-1.5">
              {tags.map((t: string) => <span class="tag">{t}</span>)}
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <div class="prose-content" set:html={contentHtml} />
      </div>
    </section>
  </article>
</BaseLayout>
