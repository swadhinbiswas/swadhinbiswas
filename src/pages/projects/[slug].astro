---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db, projects } from "../../db";
import { eq } from "drizzle-orm";
import { renderMarkdown } from "../../lib/markdown";
import "katex/dist/katex.min.css";
import "highlight.js/styles/github-dark.css";
import { getDynamicConfig } from "../../lib/config";
import { getCachedData, setCachedData } from "../../lib/redis";
import { getProjectCategories, categoryLabel } from "../../lib/projects";
import { getProjects } from "../../lib/loaders";
import { opt } from "../../lib/image";
import { thesvgIconUrl } from "../../lib/icons";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

// Try cache first
const cacheKey = `project:${slug}`;
let project: any = null;
let contentHtml = "";
let features: any = {};

const cached = await getCachedData(cacheKey);
if (cached?.project) {
  project = cached.project;
  contentHtml = cached.contentHtml;
  features = cached.features;
} else {
  // Query by slug directly instead of fetching all projects
  const results = await db.select().from(projects).where(eq(projects.slug, slug)).limit(1);
  project = results[0] || null;
  if (!project) return Astro.redirect("/404");

  const result = await renderMarkdown(project.content || project.description || "");
  contentHtml = result.html;
  features = result.features;

  // Cache for 5 minutes
  await setCachedData(cacheKey, { project, contentHtml, features }, 300);
}

const categories = await getProjectCategories();
const category = categories.find((c) => c.slug === (project.category || "data-engineering"));

const tags = (() => { try { return JSON.parse(project.tags || "[]"); } catch { return []; } })();
const techStack = (() => { try { return JSON.parse(project.techStack || "[]"); } catch { return []; } })();
const metrics = (() => { try { return JSON.parse(project.metrics || "{}"); } catch { return {}; } })();
const gallery = (() => { try { return JSON.parse(project.gallery || "[]"); } catch { return []; } })();
const projectDate = project.projectDate || project.createdAt || new Date().toISOString();

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || "https://swadhin.cv").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}/projects/${slug}/`;
// Per-project branded OG image (SVG route); falls back to the site default
const ogImage = `${siteUrl}/api/og/${slug}.svg`;
const twitterImage = project.image || `${siteUrl}/og-image.png`;
const publishedIso = new Date(projectDate).toISOString();
const tagKeywords = (Array.isArray(tags) ? tags : [])
  .map((t: unknown) => String(t).trim())
  .filter(Boolean)
  .slice(0, 10);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Projects", "item": `${siteUrl}/projects` },
        ...(category ? [{ "@type": "ListItem", "position": 3, "name": category.label, "item": `${siteUrl}/projects#cat-${category.slug}` }] : []),
        { "@type": "ListItem", "position": 4, "name": project.name, "item": canonicalUrl },
      ],
    },
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
      headline: project.name,
      description: project.description,
      keywords: tagKeywords,
      image: [ogImage],
      datePublished: publishedIso,
      author: { "@id": `${siteUrl}/#person` },
      publisher: { "@id": `${siteUrl}/#person` },
    },
    {
      "@type": "SoftwareApplication",
      name: project.name,
      applicationCategory: category?.label || "DeveloperApplication",
      operatingSystem: "Web",
      url: project.url || canonicalUrl,
      description: project.description,
      datePublished: publishedIso,
      author: { "@id": `${siteUrl}/#person` },
      ...(project.github ? { codeRepository: project.github } : {}),
    },
  ],
};

const stars = project.stars || 0;

// Strip a leading H1 that duplicates the project title (content usually opens with "# Name")
const h1Pattern = new RegExp(`^\\s*<h1[^>]*>\\s*(?:[^<]|<[^/])*?${project.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}[\\s\\S]*?</h1>`, "i");
contentHtml = contentHtml.replace(h1Pattern, "").trimStart();

// Build an on-this-page TOC from the H2s (rehype-slug adds the ids)
interface TocItem { id: string; text: string }
const toc: TocItem[] = [];
for (const m of contentHtml.matchAll(/<h2 id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)) {
  toc.push({ id: m[1], text: m[2].replace(/<[^>]+>/g, "").trim() });
}

// Split metrics into headline stats vs. facts-sidebar entries
const metricEntries = Object.entries(metrics as Record<string, string>);
const factKeys = new Set(["license", "repository_status"]);
const statMetrics = metricEntries.filter(([k]) => !factKeys.has(k));
const license = (metrics as Record<string, string>).license || null;

// Duration is stored bare ("6") — make it readable
const durationLabel = project.duration
  ? (/^\d+$/.test(String(project.duration)) ? `${project.duration} months` : project.duration)
  : null;
const teamLabel = project.teamSize
  ? `${project.teamSize} ${Number(project.teamSize) === 1 ? "person" : "people"}`
  : null;

// Reading time — ~200 words/min on the rendered content
const wordCount = ((project.content || "") + " " + (project.challenges || "") + " " + (project.outcomes || "") + " " + (project.lessonsLearned || ""))
  .replace(/[#>*\-\[\]()!`]/g, " ")
  .split(/\s+/)
  .filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Prev/next navigation by project order
const ordered = await getProjects();
const idx = ordered.findIndex((p) => p.slug === slug);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;

// Related projects in the same category (excludes current)
const relatedProjects = (await getProjects())
  .filter((p) => p.slug !== slug && (p.category || "data-engineering") === (project.category || "data-engineering"))
  .slice(0, 2);
---

<BaseLayout
  title={project.name}
  description={project.description}
  image={ogImage}
  ogType="article"
>
  <Fragment slot="head">
    <meta name="twitter:image" content={twitterImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <meta property="article:published_time" content={publishedIso} />
    {features.hasMermaid && <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js" />}
    {features.hasPlotly && <script src="https://cdn.jsdelivr.net/npm/plotly.js@3.3.1/dist/plotly.min.js" />}
    {features.hasCharts && <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js" />}
    <script is:inline>
      {features.hasMermaid && `document.addEventListener("DOMContentLoaded", () => { mermaid.initialize({ startOnLoad: true, theme: "dark", themeVariables: { primaryColor: "#FFFFFF", primaryTextColor: "#F4F4F5", primaryBorderColor: "#27272A", lineColor: "#A1A1AA", secondaryColor: "#141414", tertiaryColor: "#1A1A1A" } }); mermaid.run({ querySelector: ".mermaid" }); });`}
    </script>
  </Fragment>

  <article>
    <!-- Hero -->
    <section class="project-hero">
      <div class="container-narrow py-12 sm:py-16">
        <a href="/projects" class="text-mono inline-flex items-center gap-1.5 text-xs text-[var(--color-fg-subtle)] transition-colors hover:text-[var(--color-accent)] reveal">
          ← All projects
        </a>

        <div class="hero-grid mt-8 reveal reveal-delay-1">
          <div class="hero-main">
            <div class="flex flex-wrap items-center gap-2 text-mono text-xs text-[var(--color-fg-subtle)]">
              {category && (
                <a
                  href={`/projects#cat-${category.slug}`}
                  class="hero-chip"
                >
                  {category.label}
                </a>
              )}
              {project.status && (
                <span class="hero-chip hero-chip-status">
                  <span class="status-dot" aria-hidden="true"></span>
                  {project.status}
                </span>
              )}
              {project.featured && <span class="hero-chip">★ Featured</span>}
              <span>{new Date(projectDate).toLocaleDateString("en-US", { year: "numeric", month: "short" })}</span>
            </div>

            <h1 class="text-display mt-4 text-3xl text-[var(--color-fg)] sm:text-5xl sm:leading-[1.08]">
              <span class="text-aurora">{project.name}</span>
            </h1>

            <p class="prose-mono mt-4 max-w-prose text-[0.95rem]">{project.description}</p>

            <div class="mt-7 flex flex-wrap items-center gap-3">
              {project.url && (
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></polyline></svg>
                  Live demo
                </a>
              )}
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                  Source
                </a>
              )}
              {project.documentation && (
                <a href={project.documentation} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  Docs
                </a>
              )}
              {stars > 0 && (
                <span class="text-mono text-sm text-[var(--color-fg-muted)] cursor-default">★ {stars.toLocaleString()}</span>
              )}
            </div>
          </div>

          {project.image && (
            <div class="hero-art">
              <div class="hero-art-frame">
                <img src={opt(project.image, 720)} alt={project.name} loading="eager" decoding="async" width="360" height="360" />
              </div>
            </div>
          )}
        </div>

        {tags.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-1.5 reveal reveal-delay-2">
            {tags.map((t: string) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Headline stats -->
    {statMetrics.length > 0 && (
      <section class="screen-line-after">
        <div class="container-narrow py-8 sm:py-10">
          <dl class:list={["stats-grid", statMetrics.length <= 3 && "stats-grid-tight"]}>
            {statMetrics.map(([key, value]) => (
              <div class="stat-card reveal">
                <dt class="stat-label">{String(key).replace(/_/g, " ")}</dt>
                <dd class="stat-value">{String(value)}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <!-- Body: content + facts sidebar -->
    <section class="screen-line-after">
      <div class="container-narrow py-10 sm:py-14">
        <div class="body-grid">
          <div class="body-content min-w-0">
            {contentHtml ? (
              <div class="prose-content" set:html={contentHtml} />
            ) : (
              <div class="panel p-8 text-center">
                <p class="text-[var(--color-fg-muted)]">No detailed content yet for this project.</p>
                {project.description && (
                  <p class="text-[var(--color-fg-subtle)] text-sm mt-2">{project.description}</p>
                )}
              </div>
            )}

            <!-- Challenges & Outcomes -->
            {(project.challenges || project.outcomes || project.lessonsLearned) && (
              <div class="mt-14 space-y-10">
                {project.challenges && (
                  <div class="story-block">
                    <p class="text-eyebrow">The hard part</p>
                    <div class="prose-content prose-story mt-3" set:html={await renderMarkdown(project.challenges).then(r => r.html)} />
                  </div>
                )}
                {project.outcomes && (
                  <div class="story-block">
                    <p class="text-eyebrow">Outcome</p>
                    <div class="prose-content prose-story mt-3" set:html={await renderMarkdown(project.outcomes).then(r => r.html)} />
                  </div>
                )}
                {project.lessonsLearned && (
                  <div class="story-block">
                    <p class="text-eyebrow">What I'd do differently</p>
                    <div class="prose-content prose-story mt-3" set:html={await renderMarkdown(project.lessonsLearned).then(r => r.html)} />
                  </div>
                )}
              </div>
            )}
          </div>

          <!-- Facts sidebar -->
          <aside class="body-side">
            <div class="side-sticky">
              {(project.role || durationLabel || teamLabel || license || project.status) && (
                <div class="side-card">
                  <h3 class="side-title">Project facts</h3>
                  <dl class="side-list">
                    {project.role && (
                      <div class="side-row">
                        <dt>Role</dt>
                        <dd>{project.role}</dd>
                      </div>
                    )}
                    {durationLabel && (
                      <div class="side-row">
                        <dt>Duration</dt>
                        <dd>{durationLabel}</dd>
                      </div>
                    )}
                    {teamLabel && (
                      <div class="side-row">
                        <dt>Team</dt>
                        <dd>{teamLabel}</dd>
                      </div>
                    )}
                    {project.status && (
                      <div class="side-row">
                        <dt>Status</dt>
                        <dd>{project.status}</dd>
                      </div>
                    )}
                    {license && (
                      <div class="side-row">
                        <dt>License</dt>
                        <dd>{license}</dd>
                      </div>
                    )}
                  </dl>
                </div>
              )}

              {techStack.length > 0 && (
                <div class="side-card">
                  <h3 class="side-title">Built with</h3>
                  <ul class="tech-list">
                    {techStack.slice(0, 10).map((tech: string) => {
                      const icon = thesvgIconUrl(tech);
                      return (
                        <li class="tech-item">
                          <span class="tech-icon">
                            {icon
                              ? <img src={icon} alt="" loading="lazy" width="16" height="16" />
                              : <span class="tech-dot" aria-hidden="true"></span>}
                          </span>
                          <span>{tech}</span>
                        </li>
                      );
                    })}
                  </ul>
                  {techStack.length > 10 && (
                    <details class="tech-more">
                      <summary>+{techStack.length - 10} more</summary>
                      <ul class="tech-list mt-2">
                        {techStack.slice(10).map((tech: string) => {
                          const icon = thesvgIconUrl(tech);
                          return (
                            <li class="tech-item">
                              <span class="tech-icon">
                                {icon
                                  ? <img src={icon} alt="" loading="lazy" width="16" height="16" />
                                  : <span class="tech-dot" aria-hidden="true"></span>}
                              </span>
                              <span>{tech}</span>
                            </li>
                          );
                        })}
                      </ul>
                    </details>
                  )}
                </div>
              )}

              {toc.length > 0 && (
                <nav class="side-card" aria-label="On this page">
                  <h3 class="side-title">On this page</h3>
                  <ul class="toc-list">
                    {toc.map((item) => (
                      <li><a href={`#${item.id}`}>{item.text}</a></li>
                    ))}
                  </ul>
                </nav>
              )}
            </div>
          </aside>
        </div>
      </div>
    </section>
    <!-- Prev / Next navigation -->
    {(prev || next) && (
      <section class="screen-line-after">
        <div class="container-narrow py-10 sm:py-14">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prev && (
              <a href={`/projects/${prev.slug}/`} class="panel p-5 pager-card reveal">
                <p class="text-eyebrow">← Previous</p>
                <h3 class="pager-title">{prev.name}</h3>
              </a>
            )}
            {next && (
              <a href={`/projects/${next.slug}/`} class="panel p-5 pager-card pager-next reveal">
                <p class="text-eyebrow">Next →</p>
                <h3 class="pager-title">{next.name}</h3>
              </a>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Related projects -->
    {relatedProjects.length > 0 && (
      <section class="screen-line-after">
        <div class="container-narrow py-10 sm:py-14">
          <p class="text-eyebrow reveal">More in {category?.label || "this category"}</p>
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedProjects.map((rp) => (
              <a
                href={`/projects/${rp.slug}`}
                class="panel p-5 reveal transition-all duration-200 hover:border-[var(--color-edge-strong)] hover:translate-y-[-2px]"
              >
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-display font-bold text-[1.02rem] text-[var(--color-fg)]">{rp.name}</h3>
                  <span class="text-mono text-[var(--color-fg-subtle)]" aria-hidden="true">→</span>
                </div>
                {rp.description && (
                  <p class="mt-2 text-sm text-[var(--color-fg-muted)] line-clamp-2 leading-relaxed">{rp.description}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  (function initProjectCharts() {
    function initAll() {
      initPlotly();
      initCharts();
      initEmbeds();
    }

    function initPlotly() {
      if (typeof Plotly === "undefined") return;
      document.querySelectorAll(".plotly-container").forEach((el) => {
        try {
          const config = JSON.parse(decodeURIComponent(el.dataset.config));
          Plotly.newPlot(el, config.data || [], config.layout || {}, {
            responsive: true,
            displayModeBar: false,
            paper_bgcolor: "transparent",
            plot_bgcolor: "transparent",
            font: { color: "#A1A1AA" },
          });
        } catch (e) { console.error("Plotly error", e); }
      });
    }

    function initCharts() {
      if (typeof Chart === "undefined") return;
      document.querySelectorAll(".chart-container").forEach((el) => {
        try {
          const config = JSON.parse(decodeURIComponent(el.dataset.config));
          const canvas = document.createElement("canvas");
          el.innerHTML = "";
          el.appendChild(canvas);
          new Chart(canvas, config);
        } catch (e) { console.error("Chart error", e); }
      });
    }

    function initEmbeds() {
      document.querySelectorAll(".embed-link").forEach((el) => {
        if (el.dataset.embedLoaded) return;
        el.dataset.embedLoaded = "true";
        const slug = el.dataset.embedSlug;
        const container = document.createElement("div");
        container.className = "embedded-post loading";
        container.innerHTML = '<p class="text-sm text-[var(--color-fg-subtle)]">Loading embedded post…</p>';
        el.parentNode?.replaceChild(container, el);
        fetch(`/api/embed/${slug}`)
          .then((r) => r.text())
          .then((html) => {
            container.className = "embedded-post";
            container.innerHTML = html;
          })
          .catch(() => {
            container.innerHTML = `<a href="/posts/${slug}" class="text-[var(--color-accent)] underline">View post: ${slug.replace(/-/g, " ")}</a>`;
          });
      });
    }

    document.addEventListener("astro:page-load", initAll);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }
  })();
</script>

<style>
  /* ── Hero ── */
  .project-hero {
    border-bottom: 1px solid var(--color-edge);
    background:
      radial-gradient(ellipse 60% 50% at 70% 0%, var(--pattern-fg), transparent),
      var(--color-bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 820px) {
    .hero-grid { grid-template-columns: 1fr auto; gap: 3rem; }
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--color-edge-strong);
    background: var(--color-card);
    color: var(--color-accent-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    transition: border-color 0.2s ease, color 0.2s ease;
    text-decoration: none;
  }
  a.hero-chip:hover { border-color: var(--color-fg-subtle); color: var(--color-fg); }
  .hero-chip-status { color: var(--color-fg-muted); }
  .status-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: currentColor;
    animation: status-pulse 2s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }

  .hero-art-frame {
    width: min(300px, 60vw);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    border: 1px solid var(--color-edge);
    border-radius: 18px;
    background:
      repeating-linear-gradient(315deg, var(--pattern-fg) 0, var(--pattern-fg) 1px, transparent 1px, transparent 10px),
      var(--color-card);
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.5);
  }
  .hero-art-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ── Stats strip ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
  }
  @media (min-width: 700px) {
    .stats-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .stats-grid-tight { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .stat-card {
    border: 1px solid var(--color-edge);
    background: linear-gradient(180deg, var(--color-card) 0%, var(--color-card-strong) 100%);
    border-radius: 14px;
    padding: 1rem 1.1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .stat-card:hover { border-color: var(--color-edge-strong); transform: translateY(-1px); }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-fg-subtle);
  }
  .stat-value {
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
