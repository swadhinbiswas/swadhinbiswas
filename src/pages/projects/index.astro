---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/loaders";
import { getProjectCategories, categoryLabel } from "../../lib/projects";
import { opt } from "../../lib/image";
import { getDynamicConfig } from "../../lib/config";
import { env } from "../../lib/env";

const allProjects = await getProjects();
const categories = await getProjectCategories();

function slug(name: string) {
  return name
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, "")
    .replace(/[\s_-]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function getCardArt(name: string, id: number) {
  const lc = name.toLowerCase();
  let icon = `<path d="M14 18 L32 12 L50 18 L50 38 L32 44 L14 38 Z"/><path d="M14 18 L32 24 L50 18 M32 24 L32 44"/>`;
  if (lc.match(/storage|database|ledger|sql/)) {
    icon = `<path d="M32 12 L48 22 L48 42 L32 52 L16 42 L16 22 Z M16 22 L32 32 L48 22 M32 32 L32 52"/>`;
  } else if (lc.match(/pipeline|flow|stream|lineage/)) {
    icon = `<circle cx="16" cy="20" r="4"/><circle cx="48" cy="20" r="4"/><circle cx="16" cy="44" r="4"/><circle cx="48" cy="44" r="4"/><path d="M20 20 L44 20 M20 44 L44 44 M20 20 L20 44 M44 20 L44 44"/>`;
  } else if (lc.match(/api|server|backend|engine/)) {
    icon = `<rect x="14" y="18" width="36" height="8" rx="2"/><rect x="14" y="30" width="36" height="8" rx="2"/><rect x="14" y="42" width="36" height="8" rx="2"/><circle cx="20" cy="22" r="1.5" fill="currentColor"/><circle cx="20" cy="34" r="1.5" fill="currentColor"/><circle cx="20" cy="46" r="1.5" fill="currentColor"/>`;
  } else if (lc.match(/bot|ai|chat/)) {
    icon = `<path d="M4 1h1v1H4V1zm7 0h1v1h-1V1zM2 3h2v1H2V3zm10 0h2v1h-2V3zM1 5h14v3H1V5zm2 1v1h2V6H3zm8 0v1h2V6h-2zm-9 3h2v2H2V9zm10 0h2v2h-2V9zm-8 2h8v2H4v-2z"/>`;
  } else if (lc.match(/flux|engine|compute|performance/)) {
    icon = `<path d="M9 1H4l-2 7h5l-2 7 9-9H9l2-5z"/>`;
  }
  return `<svg viewBox="0 0 64 64" width="56" height="56" fill="none">
    <defs><linearGradient id="g-${id}" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#FFFFFF"/><stop offset="60%" stop-color="#A1A1AA"/><stop offset="100%" stop-color="#52525B"/></linearGradient></defs>
    <rect width="64" height="64" rx="12" fill="#0F0F18" stroke="url(#g-${id})" stroke-width="1.25" opacity="0.95"/>
    <g stroke="url(#g-${id})" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" fill="none">${icon}</g>
  </svg>`;
}

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || env.siteUrl || "https://swadhin.cv").replace(/\/$/, "");

// Projects grouped by category (only categories that have projects, in DB order)
const projectsByCategory = categories
  .map((cat) => ({
    ...cat,
    items: allProjects.filter((p) => (p.category || "data-engineering") === cat.slug),
  }))
  .filter((c) => c.items.length > 0);

// Projects without a matching category land under a generic bucket
const uncategorized = allProjects.filter((p) => !categories.some((c) => c.slug === (p.category || "data-engineering")));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Projects", "item": `${siteUrl}/projects` }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": `${siteUrl}/projects/#webpage`,
      url: `${siteUrl}/projects`,
      name: "Projects by Swadhin Biswas",
      description: "Production platforms, open source tools, and research deployments.",
      isPartOf: { "@id": `${siteUrl}/#website` },
      mainEntity: { "@id": `${siteUrl}/#person` },
    },
    {
      "@type": "ItemList",
      "name": "Projects by Swadhin Biswas",
      "itemListElement": allProjects.map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `${siteUrl}/projects/${p.slug}`,
        "item": {
          "@type": "CreativeWork",
          "name": p.name,
          "description": p.description,
          "url": `${siteUrl}/projects/${p.slug}`,
          "author": { "@id": `${siteUrl}/#person` },
        },
      })),
    },
  ]
};
---

<BaseLayout title="Projects" description="Selected projects, production platforms, open source tools, and research deployments by Swadhin Biswas.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
  </Fragment>

  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <div class="reveal">
        <p class="text-eyebrow">Projects</p>
        <h1 class="text-display mt-3 text-3xl sm:text-4xl text-aurora">Selected work</h1>
        <p class="prose-mono mt-4 max-w-prose">
          Production platforms, open source tools, and research deployments. Case studies are available on each project page.
        </p>
      </div>
    </div>
  </section>

  {projectsByCategory.length > 0 && (
    <nav class="category-tabs" aria-label="Project categories">
      {projectsByCategory.map((cat, i) => (
        <a href={`#cat-${cat.slug}`} class="category-tab reveal" style={`transition-delay:${i * 40}ms`}>
          <span class="category-tab-label">{cat.label}</span>
          <span class="category-tab-count">{cat.items.length}</span>
        </a>
      ))}
    </nav>
  )}

  {allProjects.length === 0 ? (
    <section class="screen-line-after">
      <div class="container-narrow py-12">
        <p class="text-sm text-[var(--color-fg-muted)] reveal">No projects yet.</p>
      </div>
    </section>
  ) : (
    <>
    {projectsByCategory.map((cat) => (
      <section id={`cat-${cat.slug}`} class="screen-line-after">
        <div class="container-narrow py-10 sm:py-14">
          <div class="reveal">
            <p class="text-eyebrow">{cat.short}</p>
            <h2 class="panel-title mt-1">{cat.label}<span class="count-badge">{cat.items.length}</span></h2>
          </div>

          <div class="projects-grid mt-6">
            {cat.items.map((p) => (
              <article class="project-card reveal">
                <a href={`/projects/${p.slug}`} class="project-card-link">
                  <div class="project-card-art" aria-hidden="true">
                    {p.image ? (
                      <img src={opt(p.image, 720)} alt={p.name} class="project-card-img" loading="lazy" decoding="async" width="720" height="360" />
                    ) : (
                      <Fragment set:html={getCardArt(p.name, p.id)} />
                    )}
                    {p.featured && <span class="featured-badge">★ Featured</span>}
                  </div>
                  <div class="project-card-body">
                    <div class="project-card-head">
                      <h3 class="project-card-title">{p.name}</h3>
                      <span class="project-card-arrow">→</span>
                    </div>
                    {p.description && (
                      <p class="project-card-desc">{p.description}</p>
                    )}
                    {p.tags.length > 0 && (
                      <div class="project-card-tags">
                        {p.tags.slice(0, 4).map((t: string) => <span class="tag">{t}</span>)}
                      </div>
                    )}
                    <div class="project-card-meta">
                      {p.url && <span class="meta-badge">Live</span>}
                      {p.github && <span class="meta-badge">Source</span>}
                      <span class="meta-badge meta-badge-cat">{categoryLabel(categories, p.category)}</span>
                    </div>
                  </div>
                </a>
                <div class="project-card-footer">
                  {p.stars > 0 && (
                    <span class="stars-badge" title="GitHub stars">★ {p.stars.toLocaleString()}</span>
                  )}
                  <a href={`/projects/${p.slug}`} class="read-more">
                    Read case study
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}
    {uncategorized.length > 0 && (
      <section id="cat-other" class="screen-line-after">
        <div class="container-narrow py-10 sm:py-14">
          <div class="reveal">
            <p class="text-eyebrow">More work</p>
            <h2 class="panel-title mt-1">Other projects<span class="count-badge">{uncategorized.length}</span></h2>
          </div>
          <div class="projects-grid mt-6">
            {uncategorized.map((p) => (
              <article class="project-card reveal">
                <a href={`/projects/${p.slug}`} class="project-card-link">
                  <div class="project-card-art" aria-hidden="true">
                    {p.image ? (
                      <img src={opt(p.image, 720)} alt={p.name} class="project-card-img" loading="lazy" decoding="async" width="720" height="360" />
                    ) : (
                      <Fragment set:html={getCardArt(p.name, p.id)} />
                    )}
                  </div>
                  <div class="project-card-body">
                    <h3 class="project-card-title">{p.name}</h3>
                    {p.description && <p class="project-card-desc">{p.description}</p>}
                    <div class="project-card-meta">
                      {p.url && <span class="meta-badge">Live</span>}
                      {p.github && <span class="meta-badge">Source</span>}
                    </div>
                  </div>
                </a>
                <div class="project-card-footer">
                  <a href={`/projects/${p.slug}`} class="read-more">
                    Read case study
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
    </>
  )}
</BaseLayout>

<style>
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-edge);
  }
  .category-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-edge);
    background: var(--color-card);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .category-tab:hover {
    border-color: var(--color-edge-strong);
    color: var(--color-fg);
    transform: translateY(-1px);
  }
  .category-tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--color-bg-2);
    border: 1px solid var(--color-edge);
    font-size: 0.62rem;
    color: var(--color-fg-subtle);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 700px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-edge);
    background: linear-gradient(180deg, var(--color-card) 0%, var(--color-card-strong) 100%);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .project-card:hover {
    border-color: var(--color-edge-strong);
    transform: translateY(-3px);
    box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.4);
  }

  .project-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-card-art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background:
      repeating-linear-gradient(315deg, rgba(255, 255, 255, 0.02) 0, rgba(255, 255, 255, 0.02) 1px, transparent 1px, transparent 10px),
      var(--color-bg-2);
    border-bottom: 1px solid var(--color-edge);
  }
  @media (prefers-color-scheme: light) {
    .project-card-art {
      background:
        repeating-linear-gradient(315deg, rgba(0, 0, 0, 0.02) 0, rgba(0, 0, 0, 0.02) 1px, transparent 1px, transparent 10px),
        var(--color-bg-2);
    }
  }
  html[data-theme="light"] .project-card-art {
    background:
      repeating-linear-gradient(315deg, rgba(0, 0, 0, 0.02) 0, rgba(0, 0, 0, 0.02) 1px, transparent 1px, transparent 10px),
      var(--color-bg-2);
  }
  .project-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-edge);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .project-card-body {
    padding: 1.1rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .project-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .project-card-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    transition: color 0.2s ease;
  }
  .project-card-arrow {
    color: var(--color-fg-subtle);
    font-size: 1rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .project-card:hover .project-card-arrow {
    transform: translateX(3px);
    color: var(--color-fg);
  }
  .project-card-desc {
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }
  .project-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }
  .meta-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-fg-subtle);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--color-edge);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
  }
  .meta-badge-cat {
    margin-left: auto;
    color: var(--color-accent-2);
    border-color: var(--color-edge-strong);
  }

  .project-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.25rem;
    border-top: 1px dashed var(--color-edge);
  }

  .stars-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent-2);
    border: 1px solid var(--color-edge-strong);
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    font-variant-numeric: tabular-nums;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .read-more:hover {
    color: var(--color-fg);
  }
  .read-more svg {
    transition: transform 0.2s ease;
  }
  .read-more:hover svg {
    transform: translateX(2px);
  }
</style>

