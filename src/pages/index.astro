---

import BaseLayout from "../layouts/BaseLayout.astro";
import { getDynamicConfig } from "../lib/config";
import { env } from "../lib/env";
import { db, faqs } from "../db";
import { asc } from "drizzle-orm";
import JsonLd from "../components/seo/JsonLd.astro";

import Hero from "../components/home/Hero.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import Skills from "../components/home/Skills.astro";
import Summary from "../components/home/Summary.astro";
import Experience from "../components/home/Experience.astro";
import Recruiters from "../components/home/Recruiters.astro";
import Faq from "../components/home/Faq.astro";
import Testimonials from "../components/home/Testimonials.astro";
import Writing from "../components/home/Writing.astro";
import Contact from "../components/home/Contact.astro";

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || env.siteUrl || Astro.url.origin).replace(/\/$/, "");
const author = siteConfig.author || env.siteName;
const siteDescription = siteConfig.description || env.siteDescription;

// FAQ entities — powers FAQPage rich results (visible in the FAQ section below)
let faqRows: any[] = [];
try { faqRows = await db.select().from(faqs).orderBy(asc(faqs.order)); } catch {}

const graph: Record<string, unknown>[] = [
  {
    "@type": "ProfilePage",
    "@id": `${siteUrl}/#profilepage`,
    url: `${siteUrl}/`,
    name: `${author} — Portfolio & Knowledge Panel`,
    description: siteDescription,
    inLanguage: "en-US",
    mainEntity: { "@id": `${siteUrl}/#person` },
    isPartOf: { "@id": `${siteUrl}/#website` },
  },
];

if (faqRows.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${siteUrl}/#faq`,
    mainEntity: faqRows.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  });
}

const schema = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<BaseLayout
  title={undefined}
  description={siteDescription}
  ogType="profile"
>
  <JsonLd slot="head" schema={schema} />

  <Hero />
  <FeaturedProjects />
  <Skills />
  <Summary />
  <Experience />
  <Recruiters />
  <Faq />
  <Testimonials />
  <Writing />
  <Contact />
</BaseLayout>
