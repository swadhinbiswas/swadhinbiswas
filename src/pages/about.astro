---

import BaseLayout from "../layouts/BaseLayout.astro";
import { getDynamicConfig } from "../lib/config";
import { db, education, achievements, interests, bioContent, siteSettings } from "../db";
import { strokeIcon } from "../lib/icons";
import JsonLd from "../components/seo/JsonLd.astro";
import { env } from "../lib/env";

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || env.siteUrl || "https://swadhin.cv").replace(/\/$/, "");

async function safe<T>(q: Promise<T>, fallback: T): Promise<T> {
  try { return await q; } catch { return fallback; }
}

const [educationList, achievementsList, interestsList, bioData, settingsData] = await Promise.all([
  safe(db.select().from(education).orderBy(education.order), [] as any[]),
  safe(db.select().from(achievements).orderBy(achievements.order), [] as any[]),
  safe(db.select().from(interests).orderBy(interests.order), [] as any[]),
  safe(db.select().from(bioContent), [] as any[]),
  safe(db.select().from(siteSettings), [] as any[]),
]);

const bio: Record<string, string> = {};
for (const b of bioData as any[]) bio[b.key] = b.value;
const settings: Record<string, string> = {};
for (const s of settingsData as any[]) settings[s.key] = s.value;

const author = settings.author || siteConfig.author;
const bioIntro = settings.intro || bio.intro || siteConfig.bio?.intro || "";
const bioStory = bio.story || siteConfig.bio?.story || "";
const bioQuote = bio.quote || siteConfig.bio?.quote || "";
const bioFunFact = bio.funFact || siteConfig.bio?.funFact || "";
const aboutCtaTitle = settings.about_cta_title || "Let's build something useful";

function formatDate(s?: string) {
  if (!s) return "Present";
  const d = new Date(s);
  if (isNaN(d.getTime())) return s;
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}

const exploreLinks = [
  { label: "Work history", href: "/experience" },
  { label: "Full stack", href: "/skills" },
  { label: "Selected projects", href: "/projects" },
  { label: "Publications", href: "/research" },
].filter((l) => l.href);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "About", "item": `${siteUrl}/about` }
      ]
    },
    {
      "@type": "AboutPage",
      "@id": `${siteUrl}/about/#webpage`,
      "url": `${siteUrl}/about`,
      "name": `About ${author}`,
      "description": `Background, education, work history, and interests of ${author}.`,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": { "@id": `${siteUrl}/#person` }
    }
  ]
};
---

<BaseLayout title="About" description={`About ${author}: story, education, work history, and interests.`}>
  <JsonLd slot="head" schema={schema} />

  <!-- Story -->
  <section class="section">
    <div class="container-narrow">
      <p class="text-eyebrow reveal">About</p>
      {bioIntro && <h1 class="about-heading reveal">{bioIntro}</h1>}
      {bioStory && <p class="about-story reveal reveal-delay-1">{bioStory}</p>}

      {bioQuote && (
        <blockquote class="about-quote reveal reveal-delay-2">
          <span class="about-quote-mark" aria-hidden="true">“</span>
          {bioQuote}
        </blockquote>
      )}

      {exploreLinks.length > 0 && (
        <nav class="about-explore reveal reveal-delay-2" aria-label="Explore more">
          {exploreLinks.map((l) => (
            <a href={l.href} class="about-explore-link">{l.label}<span aria-hidden="true">→</span></a>
          ))}
        </nav>
      )}
    </div>
  </section>

  <!-- Education -->
  {educationList.length > 0 && (
    <section class="section">
      <div class="container-narrow">
        <div class="section-head reveal">
          <div>
            <p class="text-eyebrow">Education</p>
            <h2 class="section-title">Academic background</h2>
          </div>
        </div>
        <div class="panel">
          {(educationList as any[]).map((edu) => (
            <div class="row-card">
              <div class="row-card-logo" aria-hidden="true">{edu.institution.charAt(0).toUpperCase()}</div>
              <div class="min-w-0 flex-1">
                <h3 class="row-card-title">{edu.institution}</h3>
                {edu.degree && <p class="row-card-meta">{edu.degree}</p>}
                {edu.details && <p class="edu-details">{edu.details}</p>}
              </div>
              <div class="edu-dates">
                {formatDate(edu.startDate)} to {edu.endDate ? formatDate(edu.endDate) : "Present"}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Milestones -->
  {achievementsList.length > 0 && (
    <section class="section">
      <div class="container-narrow">
        <div class="section-head reveal">
          <div>
            <p class="text-eyebrow">Milestones</p>
            <h2 class="section-title">Achievements</h2>
          </div>
          <a href="/achievements" class="section-link">All achievements →</a>
        </div>
        <div class="ach-grid">
          {(achievementsList as any[]).map((a) => (
            <a href={`/achievements/${a.slug || "index"}/`} class="panel ach-card reveal">
              <span class="ach-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={strokeIcon(a.icon)} />
              </span>
              <div class="min-w-0 flex-1">
                <div class="ach-head">
                  <h3 class="ach-name">{a.name}</h3>
                  {a.year && <span class="ach-year">{a.year}</span>}
                </div>
                {a.description && <p class="ach-desc">{a.description}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Beyond work -->
  {interestsList.length > 0 && (
    <section class="section">
      <div class="container-narrow">
        <div class="section-head reveal">
          <div>
            <p class="text-eyebrow">Beyond work</p>
            <h2 class="section-title">Interests</h2>
          </div>
        </div>
        <div class="interests-grid">
          {(interestsList as any[]).map((it) => (
            <div class="panel interest-card reveal">
              <span class="interest-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={strokeIcon(it.icon)} />
              </span>
              <div>
                <h3 class="interest-name">{it.name}</h3>
                {it.description && <p class="interest-desc">{it.description}</p>}
              </div>
            </div>
          ))}
        </div>

        {bioFunFact && (
          <p class="fun-fact reveal">
            <span class="fun-fact-label">Fun fact</span>
            {bioFunFact}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section">
    <div class="container-narrow">
      <div class="about-cta reveal">
        <h2 class="about-cta-title">{aboutCtaTitle}</h2>
        <p class="about-cta-text">
          {siteConfig.contactBlurb || "Open to data and backend engineering opportunities."}
        </p>
        <div class="about-cta-actions">
          <a href="/contact" class="btn btn-primary">Get in touch →</a>
          {siteConfig.cvUrl && (
            <a href={siteConfig.cvUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Download CV</a>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-heading {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--color-fg);
    max-width: 24ch;
  }
  .about-story {
    margin-top: 1.75rem;
    max-width: 68ch;
    color: var(--color-fg-muted);
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .about-quote {
    position: relative;
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    color: var(--color-fg);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }
  .about-quote-mark {
    display: block;
    font-size: 2.5rem;
    line-height: 0.5;
    color: var(--color-fg-subtle);
    margin-bottom: 0.75rem;
  }

  .about-explore {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-edge);
  }
  .about-explore-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    transition: color 0.2s ease, gap 0.2s ease;
  }
  .about-explore-link:hover { color: var(--color-fg); gap: 0.7rem; }

  .edu-details {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
    max-width: 62ch;
  }
  .edu-dates {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    white-space: nowrap;
    padding-top: 0.15rem;
  }
  .verify-link {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-subtle);
    transition: color 0.2s ease;
  }
  .verify-link:hover { color: var(--color-fg); }

  .ach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 700px) { .ach-grid { grid-template-columns: repeat(2, 1fr); } }
  .ach-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .ach-card:hover { border-color: var(--color-fg-subtle); transform: translateY(-2px); }
  .ach-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: var(--color-bg-2);
    border: 1px solid var(--color-edge);
    color: var(--color-fg-muted);
    flex-shrink: 0;
  }
  .ach-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .ach-name {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-fg);
  }
  .ach-year { font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-fg-subtle); }
  .ach-desc { margin-top: 0.35rem; font-size: 0.85rem; color: var(--color-fg-muted); line-height: 1.55; }

  .interests-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) { .interests-grid { grid-template-columns: repeat(2, 1fr); } }
  .interest-card {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.1rem 1.25rem;
  }
  .interest-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius);
    background: var(--color-bg-2);
    border: 1px solid var(--color-edge);
    color: var(--color-fg-muted);
    flex-shrink: 0;
  }
  .interest-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-fg);
  }
  .interest-desc { margin-top: 0.3rem; font-size: 0.84rem; color: var(--color-fg-muted); line-height: 1.55; }

  .fun-fact {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-edge);
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
  }
  .fun-fact-label {
    display: inline-block;
    margin-right: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .about-cta {
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    padding: 2.5rem 1.75rem;
    text-align: center;
  }
  .about-cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-fg);
  }
  .about-cta-text {
    margin: 0.75rem auto 0;
    max-width: 52ch;
    font-size: 0.92rem;
    color: var(--color-fg-muted);
    line-height: 1.7;
  }
  .about-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
</style>
