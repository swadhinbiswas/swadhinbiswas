---

import BaseLayout from "../layouts/BaseLayout.astro";
import { getDynamicConfig } from "../lib/config";
import { db, experiences, education, publications, skills, achievements, interests, certifications, projects, bioContent, siteSettings } from "../db";
import { thesvgIconUrl, skillInitials, strokeIcon } from "../lib/icons";
import { getLanguages } from "../lib/loaders";
import JsonLd from "../components/seo/JsonLd.astro";
import { env } from "../lib/env";

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || env.siteUrl || "https://swadhin.cv").replace(/\/$/, "");

async function safe<T>(q: Promise<T>, fallback: T): Promise<T> {
  try { return await q; } catch { return fallback; }
}

const [experiencesList, educationList, publicationsList, skillsList, achievementsList, interestsList, certificationsList, projectsRows, bioData, settingsData] = await Promise.all([
  safe(db.select().from(experiences).orderBy(experiences.startDate), [] as any[]),
  safe(db.select().from(education).orderBy(education.order), [] as any[]),
  safe(db.select().from(publications).orderBy(publications.order), [] as any[]),
  safe(db.select().from(skills).orderBy(skills.order), [] as any[]),
  safe(db.select().from(achievements).orderBy(achievements.order), [] as any[]),
  safe(db.select().from(interests).orderBy(interests.order), [] as any[]),
  safe(db.select().from(certifications).orderBy(certifications.order), [] as any[]),
  safe(db.select().from(projects).orderBy(projects.order), [] as any[]),
  safe(db.select().from(bioContent), [] as any[]),
  safe(db.select().from(siteSettings), [] as any[]),
]);
const projectsCount = projectsRows.length;
const languagesList = await getLanguages();

const levelMeta: Record<string, { label: string; pct: number }> = {
  native: { label: "Native", pct: 100 },
  fluent: { label: "Fluent", pct: 88 },
  working: { label: "Working", pct: 70 },
  learning: { label: "Learning", pct: 45 },
};

const bio: Record<string, string> = {};
for (const b of bioData as any[]) bio[b.key] = b.value;
const settings: Record<string, string> = {};
for (const s of settingsData as any[]) settings[s.key] = s.value;

const author = settings.author || siteConfig.author;
const location = settings.location || siteConfig.location;
const profileImage = settings.profile_image || "/profile.jpg";
const bioLong = bio.long || siteConfig.bio?.long || "";
const bioStory = bio.story || siteConfig.bio?.story || "";
const bioQuote = bio.quote || siteConfig.bio?.quote || "";
const bioFunFact = bio.funFact || siteConfig.bio?.funFact || "";
const languages = settings.languages || siteConfig.languages || "";
const aboutCtaTitle = settings.about_cta_title || "Let's build something useful";

function formatDate(s?: string) {
  if (!s) return "Present";
  const d = new Date(s);
  if (isNaN(d.getTime())) return s;
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}

// ── About stats (computed from DB — distinct from the hero glance cards) ──
function tenureYears(start?: string, end?: string): number {
  if (!start) return 0;
  const s = new Date(start).getTime();
  if (isNaN(s)) return 0;
  const e = end ? new Date(end).getTime() : Date.now();
  return Math.max(0, (e - s) / (365.25 * 24 * 3600 * 1000));
}
const combinedYears = experiencesList.reduce((acc, e) => acc + tenureYears(e.startDate, e.endDate), 0);
const companyCount = [...new Set((experiencesList as any[]).map((e) => e.company).filter(Boolean))].length;
const hasAcquisition = (experiencesList as any[]).some((e) => /acquired/i.test(String(e.details || "") + String(e.companyDescription || "") + String(e.learnings || "") + String(e.company || "")));
const aboutStats = [
  combinedYears >= 1 ? { label: "Years combined", value: `${Math.round(combinedYears * 10) / 10}` } : null,
  { label: "Companies", value: String(companyCount) },
  hasAcquisition ? { label: "Acquisition", value: "1" } : null,
  { label: "Skills", value: String(skillsList.length) },
  { label: "Projects", value: String(projectsCount) },
  { label: "Publications", value: String(publicationsList.length) },
].filter(Boolean) as { label: string; value: string }[];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "About", "item": `${siteUrl}/about` }
      ]
    },
    {
      "@type": "AboutPage",
      "@id": `${siteUrl}/about/#webpage`,
      "url": `${siteUrl}/about`,
      "name": `About ${author}`,
      "description": `Background, experience, education, and skills of ${author}.`,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": { "@id": `${siteUrl}/#person` }
    }
  ]
};
---

<BaseLayout title="About" description={`About ${author} — Background, Experience, Education & Research.`}>
  <JsonLd slot="head" schema={schema} />

  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <div class="about-grid reveal">
        <div class="about-portrait">
          <div class="portrait-frame">
            <img src={profileImage} alt={author} class="portrait" width="160" height="160" loading="eager" decoding="async" fetchpriority="high" />
            <span class="portrait-ring" aria-hidden="true"></span>
          </div>
        </div>
        <div>
          <p class="text-eyebrow">About</p>
          <h1 class="text-display mt-3 text-3xl sm:text-4xl">
            <span class="text-aurora">{author}</span>
          </h1>
          <p class="mt-3 text-mono text-xs text-[var(--color-fg-subtle)]">
            {[location, settings.timezone || siteConfig.timezone, languages].filter(Boolean).join(" · ")}
          </p>
          {bioLong && <p class="about-bio mt-5 max-w-prose">{bioLong}</p>}
        </div>
      </div>

      {bioQuote && (
        <blockquote class="mt-8 border-l-2 border-[var(--color-fg-subtle)] pl-4 text-base italic text-[var(--color-fg-muted)] reveal reveal-delay-1">
          "{bioQuote}"
        </blockquote>
      )}

      {aboutStats.length > 0 && (
        <dl class="about-stats reveal reveal-delay-2">
          {aboutStats.map((st) => (
            <div class="about-stat">
              <dt class="about-stat-label">{st.label}</dt>
              <dd class="about-stat-value">{st.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>

  {achievementsList.length > 0 && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <div class="section-head reveal">
          <div>
            <p class="text-eyebrow">Milestones</p>
            <h2 class="panel-title mt-1">Achievements<span class="count-badge">{achievementsList.length}</span></h2>
          </div>
          <a href="/achievements" class="section-link">All achievements →</a>
        </div>
        <div class="ach-grid">
          {(achievementsList as any[]).map((a) => (
            <a
              href={`/achievements/${a.slug || "index"}/`}
              class="panel p-5 ach-card reveal"
            >
              <span class="ach-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={strokeIcon(a.icon)} />
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="ach-name">{a.name}</h3>
                  {a.year && <span class="ach-year">{a.year}</span>}
                </div>
                {a.description && <p class="ach-desc">{a.description}</p>}
                <div class="mt-2 flex flex-wrap items-center gap-3">
                  <span class="ach-cta">
                    How it happened
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                  </span>
                  {a.url && (
                    <span class="ach-proof" aria-hidden="true">Proof ↗</span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {certificationsList.length > 0 && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <h2 class="panel-title mb-6 reveal">Certifications<span class="count-badge">{certificationsList.length}</span></h2>
        <div class="panel">
          {(certificationsList as any[]).map((cert) => (
            <div class="row-card group">
              <div class="row-card-logo" aria-hidden="true">{cert.issuer.charAt(0).toUpperCase()}</div>
              <div class="min-w-0 flex-1">
                <h3 class="row-card-title">{cert.name}</h3>
                <p class="row-card-meta">
                  {cert.issuer}
                  {cert.year && ` · ${cert.year}`}
                  {cert.credentialId && ` · ID: ${cert.credentialId}`}
                </p>
              </div>
              <div class="row-card-actions">
                {cert.url && (
                  <a href={cert.url} target="_blank" rel="noopener noreferrer" class="text-mono text-[10px] uppercase tracking-wider text-[var(--color-fg-subtle)] transition-colors hover:text-[var(--color-fg)]">
                    Verify ↗
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {bioStory && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <p class="text-eyebrow reveal">Story</p>
        <div class="mt-4 prose-mono max-w-prose reveal reveal-delay-1">
          <p>{bioStory}</p>
        </div>
        {bioFunFact && (
          <p class="mt-6 text-mono text-xs text-[var(--color-fg-subtle)] reveal reveal-delay-2">Fun fact: {bioFunFact}</p>
        )}
      </div>
    </section>
  )}

  {experiencesList.length > 0 && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <div class="section-head reveal">
          <div>
            <p class="text-eyebrow">Work history</p>
            <h2 class="panel-title mt-1">Experience<span class="count-badge">{experiencesList.length}</span></h2>
          </div>
          <a href="/experience" class="section-link">Full timeline →</a>
        </div>
        <div class="panel">
          {([...experiencesList] as any[]).reverse().map((exp) => {
            const responsibilities = (() => { try { return JSON.parse(exp.responsibilities || "[]"); } catch { return []; } })();
            const learnings = (() => { try { return JSON.parse(exp.learnings || "[]"); } catch { return []; } })();
            return (
            <div class="exp-card">
              <button class="exp-card-trigger group" onclick={`this.closest('.exp-card').classList.toggle('expanded')`} type="button" aria-expanded="false">
                <div class="exp-card-header">
                  <div class="exp-card-logo" aria-hidden="true">
                    {exp.logoUrl ? (
                      <img src={exp.logoUrl} alt="" class="w-full h-full object-contain rounded" />
                    ) : (
                      exp.company?.charAt(0)?.toUpperCase() || "?"
                    )}
                  </div>
                  <div class="min-w-0 flex-1 text-left">
                    <h3 class="row-card-title">
                      {exp.role}
                      <span class="text-[var(--color-fg-muted)]"> · {exp.company}</span>
                    </h3>
                    <div class="text-mono text-[10px] uppercase tracking-wider text-[var(--color-fg-subtle)] mt-0.5">
                      {formatDate(exp.startDate)} — {formatDate(exp.endDate)}
                      {(() => { const t = tenureYears(exp.startDate, exp.endDate); return t >= 1 ? ` · ${Math.round(t * 10) / 10} yrs` : ""; })()}
                    </div>
                  </div>
                  <div class="exp-card-chevron">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </div>
                </div>
              </button>
              <div class="exp-card-body">
                {exp.companyDescription && (
                  <p class="exp-card-company-desc">{exp.companyDescription}</p>
                )}
                {exp.details && (
                  <p class="exp-card-details">{exp.details}</p>
                )}
                {responsibilities.length > 0 && (
                  <div class="exp-card-section">
                    <span class="exp-card-section-icon">▹</span>
                    <div>
                      <p class="exp-card-section-label">Key Responsibilities</p>
                      <ul class="exp-card-list">
                        {responsibilities.map((r: string) => (
                          <li class="exp-card-list-item">
                            <span class="exp-card-bullet" aria-hidden="true">▹</span>
                            <span>{r}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}
                {learnings.length > 0 && (
                  <div class="exp-card-section">
                    <span class="exp-card-section-icon learn">✦</span>
                    <div>
                      <p class="exp-card-section-label">Key Learnings</p>
                      <ul class="exp-card-list learn-list">
                        {learnings.map((l: string) => (
                          <li class="exp-card-list-item">
                            <span class="exp-card-bullet learn-bullet" aria-hidden="true">✦</span>
                            <span>{l}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}
                {exp.url && (
                  <a href={exp.url} target="_blank" rel="noopener noreferrer" class="exp-card-link">
                    {(() => { try { return new URL(exp.url).hostname; } catch { return exp.url; } })()} ↗
                  </a>
                )}
              </div>
            </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {educationList.length > 0 && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <h2 class="panel-title mb-6 reveal">Education<span class="count-badge">{educationList.length}</span></h2>
        <div class="panel">
          {(educationList as any[]).map((edu) => (
            <div class="row-card group">
              <div class="row-card-logo" aria-hidden="true">
                {edu.institution.charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="row-card-title">{edu.institution}</h3>
                {edu.degree && <p class="row-card-meta">{edu.degree}</p>}
                {edu.details && (
                  <p class="prose-mono mt-1 line-clamp-2">{edu.details}</p>
                )}
              </div>
              <div class="text-mono text-[10px] uppercase tracking-wider text-[var(--color-fg-subtle)]">
                {formatDate(edu.startDate)} — {formatDate(edu.endDate)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {publicationsList.length > 0 && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <div class="section-head reveal">
          <div>
            <p class="text-eyebrow">Research</p>
            <h2 class="panel-title mt-1">Publications<span class="count-badge">{publicationsList.length}</span></h2>
          </div>
          <a href="/research" class="section-link">All publications →</a>
        </div>
        <div class="panel">
          {(publicationsList as any[]).map((pub) => (
            <a
              href={pub.url || "#"}
              target={pub.url ? "_blank" : undefined}
              rel={pub.url ? "noopener noreferrer" : undefined}
              class="row-card group"
            >
              <div class="text-mono text-[10px] uppercase tracking-wider text-[var(--color-fg-subtle)] w-14 flex-shrink-0 pt-1">
                {formatDate(pub.date)}
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="row-card-title">{pub.title}</h3>
                {pub.venue && <p class="row-card-meta">{pub.venue}</p>}
                {pub.description && (
                  <p class="prose-mono mt-1 line-clamp-2">{pub.description}</p>
                )}
              </div>
              <div class="row-card-actions">
                {pub.url && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {skillsList.length > 0 && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <div class="section-head reveal">
          <div>
            <p class="text-eyebrow">Capabilities</p>
            <h2 class="panel-title mt-1">Stack<span class="count-badge">{skillsList.length}</span></h2>
          </div>
          <a href="/skills" class="section-link">Full stack →</a>
        </div>
        <div class="flex flex-wrap gap-2 reveal">
          {(skillsList as any[]).map((s) => {
            const iconUrl = thesvgIconUrl(s.name);
            return iconUrl ? (
              <span class="icon-chip" title={s.name}>
                <img src={iconUrl} alt={s.name} class="icon-chip-img" loading="lazy" />
              </span>
            ) : (
              <span class="icon-chip" title={s.name}>{skillInitials(s.name)}</span>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {interestsList.length > 0 && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <h2 class="panel-title mb-6 reveal">Interests<span class="count-badge">{interestsList.length}</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {(interestsList as any[]).map((it) => (
            <div class="panel p-4 interest-card reveal">
              <span class="interest-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={strokeIcon(it.icon)} />
              </span>
              <div>
                <h3 class="interest-name">{it.name}</h3>
                {it.description && <p class="interest-desc">{it.description}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {languagesList.length > 0 && (
    <section class="screen-line-after">
      <div class="container-narrow py-12 sm:py-16">
        <h2 class="panel-title mb-6 reveal">Languages<span class="count-badge">{languagesList.length}</span></h2>
        <div class="panel">
          {(languagesList as any[]).map((l) => {
            const meta = levelMeta[l.level] || levelMeta.learning!;
            return (
              <div class="row-card group">
                <div class="lang-name-col" aria-hidden="true">
                  <span class="lang-initials">{l.name.charAt(0).toUpperCase()}</span>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="row-card-title">{l.name}</h3>
                    <span class="lang-level">{meta.label}</span>
                  </div>
                  {l.note && <p class="row-card-meta">{l.note}</p>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 reveal">
        <div>
          <p class="text-eyebrow">Based in</p>
          <p class="mt-1.5 text-sm text-[var(--color-fg)]">{location || "—"}</p>
        </div>
        <div>
          <p class="text-eyebrow">Relocation</p>
          <p class="mt-1.5 text-sm text-[var(--color-fg)]">{siteConfig.relocationTargets || "—"}</p>
        </div>
        <div>
          <p class="text-eyebrow">English</p>
          <p class="mt-1.5 text-sm text-[var(--color-fg)]">{siteConfig.englishLevel || "—"}</p>
        </div>
        <div>
          <p class="text-eyebrow">Email</p>
          <p class="mt-1.5">
            <a href={`mailto:${siteConfig.email}`} class="text-sm text-[var(--color-fg-subtle)] hover:underline">
              {siteConfig.email || "—"}
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="screen-line-after">
    <div class="container-narrow pb-12 sm:pb-16">
      <div class="panel p-6 sm:p-8 text-center reveal">
        <h2 class="panel-title">{aboutCtaTitle}</h2>
        <p class="mt-3 mx-auto max-w-prose text-sm text-[var(--color-fg-muted)] leading-relaxed">
          {siteConfig.contactBlurb || "Open to senior data and backend engineering opportunities."}
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="/contact" class="btn btn-primary">Get in touch →</a>
          {siteConfig.cvUrl && (
            <a href={siteConfig.cvUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Download CV</a>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lang-name-col {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: var(--color-card);
    border: 1px solid var(--color-edge);
    flex-shrink: 0;
  }
  .lang-initials {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-fg-subtle);
  }
  .lang-level {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-2);
    border: 1px solid var(--color-edge);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    white-space: nowrap;
  }

  .about-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 2rem;
  }
  @media (max-width: 720px) {
    .about-grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }
  .about-portrait { display: flex; justify-content: center; }
  .portrait-frame {
    position: relative;
    width: 160px;
    height: 160px;
    flex-shrink: 0;
  }
  @media (max-width: 720px) { .portrait-frame { width: 120px; height: 120px; } }
  .portrait {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    object-fit: cover;
    background: var(--color-card);
    border: 3px solid var(--color-edge);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 12px 32px -8px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 1;
  }
  .portrait-ring {
    position: absolute;
    inset: -6px;
    border-radius: 999px;
    background: conic-gradient(from 0deg, #FFFFFF, #71717A, #FFFFFF);
    z-index: 0;
    opacity: 0.55;
    filter: blur(8px);
    animation: ring-spin 8s linear infinite;
  }
  @keyframes ring-spin { to { transform: rotate(360deg); } }

