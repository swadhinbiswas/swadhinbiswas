---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { getDynamicConfig } from "../lib/config";
import { db, publications } from "../db";
import JsonLd from "../components/seo/JsonLd.astro";
import { env } from "../lib/env";

const siteConfig = await getDynamicConfig();
const siteUrl = (siteConfig.url || env.siteUrl || "https://swadhin.cv").replace(/\/$/, "");

async function safe<T>(q: Promise<T>, fallback: T): Promise<T> {
  try { return await q; } catch { return fallback; }
}

const publicationsList = await safe(
  db.select().from(publications).orderBy(publications.order),
  [] as any[]
);

function formatDate(s?: string) {
  if (!s) return "—";
  const d = new Date(s);
  if (isNaN(d.getTime())) return s;
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Research", "item": `${siteUrl}/research` }
      ]
    },
    {
      "@type": "ItemList",
      "name": `Research & Publications by ${siteConfig.author}`,
      "itemListElement": publicationsList.map((pub, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "ScholarlyArticle",
          "name": pub.title,
          "headline": pub.title,
          "description": pub.description || undefined,
          "url": pub.url || undefined,
          "datePublished": pub.date || undefined,
          "publisher": pub.venue ? { "@type": "Organization", "name": pub.venue } : undefined,
          "author": { "@id": `${siteUrl}/#person` }
        }
      }))
    }
  ]
};
---

<BaseLayout title="Research" description={`Peer-reviewed research and publications by ${siteConfig.author}.`}>
  <JsonLd slot="head" schema={schema} />
  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      <div class="reveal">
        <p class="text-eyebrow">Research</p>
        <h1 class="text-display mt-3 text-3xl sm:text-4xl text-aurora">Selected publications</h1>
        <p class="prose-mono mt-4 max-w-prose">
          Peer-reviewed and preprint work in AI systems, ML infrastructure, and applied research.
        </p>
      </div>
    </div>
  </section>

  <section class="screen-line-after">
    <div class="container-narrow py-12 sm:py-16">
      {publicationsList.length === 0 ? (
        <p class="text-sm text-[var(--color-fg-muted)] reveal">No publications yet.</p>
      ) : (
        <div class="panel">
          <div class="panel-top"></div>
          {(publicationsList as any[]).map((pub) => (
            <a
              href={pub.url || "#"}
              target={pub.url ? "_blank" : undefined}
              rel={pub.url ? "noopener noreferrer" : undefined}
              class="row-card group"
            >
              <div class="text-mono text-[10px] uppercase tracking-wider text-[var(--color-fg-subtle)] w-14 flex-shrink-0 pt-1">
                {formatDate(pub.date)}
              </div>
              <div class="min-w-0 flex-1 row-card-divider">
                <h3 class="row-card-title">{pub.title}</h3>
                {pub.venue && <p class="row-card-meta">{pub.venue}</p>}
                {pub.description && (
                  <p class="prose-mono mt-1 line-clamp-3">{pub.description}</p>
                )}
              </div>
              <div class="row-card-actions">
                {pub.url && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                )}
              </div>
            </a>
          ))}
          <div class="panel-bottom"></div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
