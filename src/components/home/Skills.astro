---
import { getSkills, getProjects } from "../../lib/loaders";
import { thesvgIconUrl, skillInitials } from "../../lib/icons";

interface Skill {
  id: number;
  name: string;
  category?: string;
  description?: string;
  usedIn?: string;
  tier?: string;
}

interface Project {
  id: number;
  name: string;
  tags: string;
}

const [all, allProjects] = await Promise.all([
  getSkills() as Promise<Skill[]>,
  getProjects() as Promise<Project[]>,
]);


function safeJSON(s: any): string[] {
  try { return JSON.parse(s); } catch { return []; }
}

const projectTagsMap = new Map<string, string[]>();
for (const proj of allProjects) {
  const tags = safeJSON(proj.tags);
  if (tags.length > 0) projectTagsMap.set(proj.name.toLowerCase(), tags);
}

const skillToProjects = new Map<string, string[]>();
for (const [projName, tags] of projectTagsMap) {
  for (const tag of tags) {
    const normalized = tag.toLowerCase();
    const existing = skillToProjects.get(normalized) || [];
    if (!existing.includes(projName)) {
      existing.push(projName);
      skillToProjects.set(normalized, existing);
    }
  }
}

for (const skill of all) {
  const key = skill.name.toLowerCase();
  if (!skill.usedIn) {
    const linkedProjects = skillToProjects.get(key) || [];
    if (linkedProjects.length > 0) skill.usedIn = JSON.stringify(linkedProjects);
  }
}

const grouped = all.reduce<Record<string, Skill[]>>((acc, skill) => {
  const category = skill.category || "general";
  acc[category] = acc[category] || [];
  acc[category].push(skill);
  return acc;
}, {});

const categoryOrder: Record<string, number> = {
  "language": 1, "framework": 2, "data engineering": 3, "database": 4,
  "devops": 5, "ai": 6, "general": 7,
};

const sortedCategories = Object.entries(grouped).sort(
  ([a], [b]) => (categoryOrder[a] || 99) - (categoryOrder[b] || 99)
);

const categoryLabel = (category: string) =>
  category.split(/[-_\s]+/).map((p) => p.charAt(0).toUpperCase() + p.slice(1)).join(" ");

const totalSkills = all.length;
const totalCore = all.filter((s) => s.tier === "core").length;
---

<section id="skills" class="section">
  <div class="container-narrow">
    <div class="section-head reveal">
      <div>
        <p class="text-eyebrow">Capabilities</p>
        <h2 class="section-title">
          Stack
          {totalSkills > 0 && <span class="count-badge">{totalSkills}</span>}
        </h2>
        {totalCore > 0 && (
          <p class="section-sub">
            <span class="dot-core"></span>
            {totalCore} core · {totalSkills - totalCore} working
          </p>
        )}
      </div>
      <a href="/skills" class="section-link">Full stack →</a>
    </div>

    {all.length === 0 ? (
      <p class="panel p-6 text-sm text-[var(--color-fg-muted)] reveal">
        Skills will appear here once added from the admin panel.
      </p>
    ) : (
      <div class="skill-clusters">
        {sortedCategories.slice(0, 3).map(([category, items]) => {
          const core = items.filter((s) => s.tier === "core");
          const working = items.filter((s) => s.tier !== "core");
          return (
            <article class="skill-cluster reveal">
              <header class="cluster-head">
                <h3 class="cluster-name">{categoryLabel(category)}</h3>
                <span class="cluster-count">{items.length}</span>
              </header>
              <div class="cluster-tiles">
                {core.map((s) => {
                  const iconUrl = thesvgIconUrl(s.name);
                  return (
                    <div class="skill-tile core" title={(s.description ? s.description + ' · ' : '') + (s.tier === 'core' ? 'Core' : 'Working')}>
                      <span class="skill-tile-icon">
                        {iconUrl ? <img src={iconUrl} alt="" loading="lazy" width="18" height="18" class="skill-tile-img" /> : <span class="skill-tile-initials">{skillInitials(s.name)}</span>}
                      </span>
                      <span class="skill-tile-name">{s.name}</span>
                    </div>
                  );
                })}
                {working.map((s) => {
                  const iconUrl = thesvgIconUrl(s.name);
                  return (
                    <div class="skill-tile" title={(s.description ? s.description + ' · ' : '') + (s.tier === 'core' ? 'Core' : 'Working')}>
                      <span class="skill-tile-icon">
                        {iconUrl ? <img src={iconUrl} alt="" loading="lazy" width="18" height="18" class="skill-tile-img" /> : <span class="skill-tile-initials">{skillInitials(s.name)}</span>}
                      </span>
                      <span class="skill-tile-name">{s.name}</span>
                    </div>
                  );
                })}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .section-sub {
    margin-top: 0.45rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-fg-subtle);
  }
  .dot-core {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-cyan));
  }

  .skill-clusters {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .cluster-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.7rem;
  }
  .cluster-name {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-fg);
    letter-spacing: -0.01em;
  }
  .cluster-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
  }
  .cluster-tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skill-tile {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-edge);
    background: var(--color-card);
    border-radius: 999px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .skill-tile:hover { border-color: var(--color-accent-2); transform: translateY(-1px); }
  .skill-tile.core {
    border-color: var(--color-edge-strong);
    background: rgba(255, 255, 255, 0.03);
  }
  .skill-tile-icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .skill-tile-img { width: 18px; height: 18px; object-fit: contain; }
  .skill-tile-initials {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    color: var(--color-accent-2);
    letter-spacing: 0.05em;
  }
  .skill-tile-name {
    font-size: 0.78rem;
    color: var(--color-fg-muted);
  }
  .skill-tile:hover .skill-tile-name { color: var(--color-fg); }
</style>
