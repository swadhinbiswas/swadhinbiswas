---
import { getExperiences } from "../../lib/loaders";

interface Experience {
  id: number;
  company: string;
  role: string;
  url?: string;
  companyDescription?: string;
  startDate: string;
  endDate?: string;
  details?: string;
}

const experiencesList = (await getExperiences()) as Experience[];
const highlights = experiencesList.slice(0, 3);


function formatDate(s?: string) {
  if (!s) return "Present";
  const d = new Date(s);
  if (isNaN(d.getTime())) return s;
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}

function hostname(url?: string) {
  if (!url) return "";
  try { return new URL(url).hostname; } catch { return url; }
}
---

<section id="experience" class="section">
  <div class="container-narrow">
    <div class="section-head reveal">
      <div>
        <p class="text-eyebrow">Work history</p>
        <h2 class="section-title">
          Experience
          {experiencesList.length > 0 && <span class="count-badge">{experiencesList.length}</span>}
        </h2>
      </div>
      <a href="/experience" class="section-link">Full timeline →</a>
    </div>

    {highlights.length === 0 ? (
      <div class="panel p-6 text-sm text-[var(--color-fg-muted)] reveal">
        Experience will appear here once added from the admin panel.
      </div>
    ) : (
      <div class="panel panel-accent">
        <ol class="exp-list reveal reveal-delay-1">
          {highlights.map((exp) => (
            <li class="exp-row">
              <div class="exp-dot" aria-hidden="true"></div>
              <div class="exp-body">
                <div class="exp-head">
                  <h3 class="exp-title">
                    {exp.role}
                    {exp.company && <span class="exp-company"> · {exp.company}</span>}
                  </h3>
                  <time class="exp-dates">{formatDate(exp.startDate)} — {formatDate(exp.endDate)}</time>
                </div>
                {exp.details && <p class="exp-details">{exp.details}</p>}
                {(exp.companyDescription || exp.url) && (
                  <div class="exp-meta">
                    {exp.companyDescription && <span class="exp-about">{exp.companyDescription}</span>}
                    {exp.url && (
                      <a class="exp-link" href={exp.url} target="_blank" rel="noopener noreferrer">
                        {hostname(exp.url)} ↗
                      </a>
                    )}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}
  </div>
</section>

<style>
  .exp-list { list-style: none; margin: 0; padding: 0.4rem 0; }
  .exp-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.05rem 1.25rem;
    border-top: 1px solid var(--color-edge);
    transition: background-color 0.2s ease;
  }
  .exp-row:hover { background: rgba(255, 255, 255, 0.02); }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .exp-row:hover { background: rgba(0, 0, 0, 0.02); }
  }
  html[data-theme="light"] .exp-row:hover { background: rgba(0, 0, 0, 0.02); }
  .exp-row:first-child { border-top: 0; }

  .exp-dot {
    margin-top: 0.45rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--color-fg);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }

  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .exp-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-fg);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .exp-company { color: var(--color-fg-muted); font-weight: 500; }
  .exp-dates {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    white-space: nowrap;
  }
  .exp-details {
    margin-top: 0.4rem;
    color: var(--color-fg-muted);
    font-size: 0.87rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .exp-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
  }
  .exp-about {
    font-size: 0.78rem;
    color: var(--color-fg-subtle);
    font-style: italic;
  }
  .exp-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-fg-subtle);
    transition: color 0.2s ease;
  }
  .exp-link:hover { color: var(--color-fg); }
</style>
