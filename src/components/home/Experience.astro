---
import { getExperiences } from "../../lib/loaders";

interface Experience {
  id: number;
  company: string;
  role: string;
  url?: string;
  companyDescription?: string;
  startDate: string;
  endDate?: string;
  details?: string;
}

const experiencesList = (await getExperiences()) as Experience[];
const highlights = experiencesList.slice(0, 4);

function formatDate(s?: string) {
  if (!s) return "Present";
  const d = new Date(s);
  if (isNaN(d.getTime())) return s;
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}

function hostname(url?: string) {
  if (!url) return "";
  try { return new URL(url).hostname; } catch { return url; }
}
---

<section id="experience" class="section">
  <div class="container-narrow">
    <div class="section-head reveal">
      <div>
        <p class="text-eyebrow">Work history</p>
        <h2 class="section-title">
          Experience
          {experiencesList.length > 0 && <span class="count-badge">{experiencesList.length}</span>}
        </h2>
      </div>
      <a href="/experience" class="section-link">Full timeline →</a>
    </div>

    {highlights.length === 0 ? (
      <div class="panel p-6 text-sm text-[var(--color-fg-muted)] reveal">
        Experience appears here once it's added from the admin panel.
      </div>
    ) : (
      <ol class="exp-list reveal reveal-delay-1">
        {highlights.map((exp) => (
          <li class="exp-row">
            <div class="exp-marker" aria-hidden="true">
              <span class="exp-marker-dot"></span>
            </div>
            <div class="exp-body">
              <div class="exp-head">
                <h3 class="exp-title">
                  {exp.role}
                  {exp.company && <span class="exp-company"> · {exp.company}</span>}
                </h3>
                <time class="exp-dates">{formatDate(exp.startDate)} to {formatDate(exp.endDate)}</time>
              </div>
              {exp.details && <p class="exp-details">{exp.details}</p>}
              {(exp.companyDescription || exp.url) && (
                <div class="exp-meta">
                  {exp.companyDescription && <span class="exp-about">{exp.companyDescription}</span>}
                  {exp.url && (
                    <a class="exp-link" href={exp.url} target="_blank" rel="noopener noreferrer">
                      {hostname(exp.url)} ↗
                    </a>
                  )}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .exp-list { list-style: none; margin: 0; padding: 0; }
  .exp-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.35rem 0;
    border-top: 1px solid var(--color-edge);
  }
  .exp-row:first-child { border-top: 0; padding-top: 0; }

  .exp-marker {
    position: relative;
    width: 0.9rem;
    display: flex;
    justify-content: center;
    padding-top: 0.4rem;
  }
  .exp-marker::before {
    content: "";
    position: absolute;
    top: 1.4rem;
    bottom: -1.35rem;
    width: 1px;
    background: var(--color-edge);
  }
  .exp-row:last-child .exp-marker::before { display: none; }
  .exp-marker-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1.5px solid var(--color-fg-subtle);
    flex-shrink: 0;
    z-index: 1;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .exp-row:hover .exp-marker-dot { border-color: var(--color-fg); background: var(--color-fg); }

  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }
  .exp-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--color-fg);
    letter-spacing: -0.015em;
    line-height: 1.4;
  }
  .exp-company { color: var(--color-fg-muted); font-weight: 500; }
  .exp-dates {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    white-space: nowrap;
  }
  .exp-details {
    margin-top: 0.5rem;
    color: var(--color-fg-muted);
    font-size: 0.88rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .exp-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.6rem;
  }
  .exp-about {
    font-size: 0.78rem;
    color: var(--color-fg-subtle);
    font-style: italic;
  }
  .exp-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-fg-subtle);
    transition: color 0.2s ease;
  }
  .exp-link:hover { color: var(--color-fg); }
</style>
