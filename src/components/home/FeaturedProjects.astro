---
import { getProjects } from "../../lib/loaders";
import { getProjectCategories, categoryBySlug } from "../../lib/projects";
import { opt } from "../../lib/image";

const allProjects = await getProjects();
const categories = await getProjectCategories();

function initials(name: string): string {
  const parts = name.trim().split(/[\s-]+/).filter(Boolean);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[1][0]).toUpperCase();
}

const visible = allProjects.slice(0, 6);
---

<section id="projects" class="section">
  <div class="container-narrow">
    <div class="section-head reveal">
      <div>
        <p class="text-eyebrow">Selected work</p>
        <h2 class="section-title">
          Projects
          {allProjects.length > 0 && <span class="count-badge">{allProjects.length}</span>}
        </h2>
      </div>
      {allProjects.length > 0 && (
        <a href="/projects" class="section-link">All projects →</a>
      )}
    </div>

    {allProjects.length === 0 ? (
      <div class="panel p-8 text-center reveal">
        <p class="text-sm text-[var(--color-fg-muted)]">Projects are being published — check back soon.</p>
        <a href="/contact" class="btn btn-outline mt-4">Get in touch</a>
      </div>
    ) : (
      <div class="projects-grid">
        {visible.map((p, i) => {
          const cat = categoryBySlug(categories, p.category);
          return (
            <a href={`/projects/${p.slug}/`} class:list={["project-card", "reveal", i === 0 && "project-card--wide"]}>
              <div class="project-card-art" aria-hidden="true">
                {p.image ? (
                  <img src={opt(p.image, 720)} alt={p.name} class="project-card-img" loading="lazy" decoding="async" width="720" height="360" />
                ) : (
                  <span class="project-card-glyph">{initials(p.name)}</span>
                )}
                <span class="project-card-cat">{cat?.label || "Project"}</span>
              </div>
              <div class="project-card-body">
                <h3 class="project-card-title">
                  {p.name}
                  <svg class="project-card-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </h3>
                {p.description && <p class="project-card-desc">{p.description}</p>}
                {p.tags.length > 0 && (
                  <div class="project-card-tags">
                    {p.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
                  </div>
                )}
                <div class="project-card-meta">
                  {p.url && <span class="meta-badge">Live</span>}
                  {p.github && <span class="meta-badge">Source</span>}
                  {p.stars != null && p.stars > 0 && <span class="meta-badge">★ {p.stars.toLocaleString()}</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 700px) { .projects-grid { grid-template-columns: repeat(2, 1fr); } }

  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-edge);
    background: var(--color-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .project-card:hover {
    border-color: var(--color-fg-subtle);
    transform: translateY(-2px);
  }

  /* First project spans the grid as a wide feature */
  @media (min-width: 700px) {
    .project-card--wide {
      grid-column: 1 / -1;
      flex-direction: row;
    }
    .project-card--wide .project-card-art {
      width: 46%;
      flex-shrink: 0;
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--color-edge);
    }
    .project-card--wide .project-card-body {
      justify-content: center;
      padding: 1.75rem 1.85rem;
      gap: 0.8rem;
    }
    .project-card--wide .project-card-title { font-size: 1.4rem; }
    .project-card--wide .project-card-desc { -webkit-line-clamp: 4; font-size: 0.92rem; }
  }

  .project-card-art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 8;
    background: var(--color-bg-2);
    border-bottom: 1px solid var(--color-edge);
    overflow: hidden;
    color: var(--color-fg-subtle);
  }
  .project-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.4s ease, transform 0.5s ease;
  }
  .project-card:hover .project-card-img { filter: grayscale(0); transform: scale(1.02); }
  .project-card-art::after {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3rem;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.28), transparent);
    pointer-events: none;
  }
  .project-card-cat {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 1;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-card);
    border: 1px solid var(--color-edge-strong);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .project-card-glyph {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-fg-subtle);
    opacity: 0.7;
    user-select: none;
  }

  .project-card-body { padding: 1.15rem 1.25rem 1.25rem; display: flex; flex-direction: column; gap: 0.65rem; flex: 1; }
  .project-card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    line-height: 1.25;
  }
  .project-card-arrow {
    color: var(--color-fg-subtle);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .project-card:hover .project-card-arrow { transform: translateX(3px); color: var(--color-fg); }
  .project-card-desc {
    color: var(--color-fg-muted);
    font-size: 0.86rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: auto; }
  .project-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-edge);
  }
  .meta-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--color-fg-subtle);
    padding: 0.16rem 0.45rem;
    border: 1px solid var(--color-edge);
    border-radius: 5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
