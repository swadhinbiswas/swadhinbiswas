---
import { getProjects } from "../../lib/loaders";
import { getProjectCategories, categoryBySlug } from "../../lib/projects";
import { opt } from "../../lib/image";

const allProjects = await getProjects();
const categories = await getProjectCategories();

function categoryIcon(cat?: string | null): string {
  switch (cat) {
    case "data-engineering":
      return `<path d="M32 12 L48 22 L48 42 L32 52 L16 42 L16 22 Z M16 22 L32 32 L48 22 M32 32 L32 52"/>`;
    case "web":
      return `<rect x="14" y="18" width="36" height="8" rx="2"/><rect x="14" y="30" width="36" height="8" rx="2"/><rect x="14" y="42" width="36" height="8" rx="2"/><circle cx="20" cy="22" r="1.5"/><circle cx="20" cy="34" r="1.5"/><circle cx="20" cy="46" r="1.5"/>`;
    case "cli-tools":
      return `<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/><polyline points="20 21 14 15 20 9"/>`;
    case "ai-ml":
      return `<circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>`;
    case "devops":
      return `<rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>`;
    case "research":
      return `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`;
    default:
      return `<path d="M14 18 L32 12 L50 18 L50 38 L32 44 L14 38 Z"/><path d="M14 18 L32 24 L50 18 M32 24 L32 44"/>`;
  }
}

const visible = allProjects.slice(0, 6);
---

<section id="projects" class="section">
  <div class="container-narrow">
    <div class="section-head reveal">
      <div>
        <p class="text-eyebrow">Selected work</p>
        <h2 class="section-title">
          Projects
          {allProjects.length > 0 && <span class="count-badge">{allProjects.length}</span>}
        </h2>
      </div>
      {allProjects.length > 0 && (
        <a href="/projects" class="section-link">All projects →</a>
      )}
    </div>

    {allProjects.length === 0 ? (
      <div class="panel p-8 text-center reveal">
        <p class="text-sm text-[var(--color-fg-muted)]">Projects are being published — check back soon.</p>
        <a href="/contact" class="btn btn-outline mt-4">Get in touch</a>
      </div>
    ) : (
      <div class="projects-grid">
        {visible.map((p) => {
          const cat = categoryBySlug(categories, p.category);
          return (
            <a href={`/projects/${p.slug}/`} class="project-card reveal">
              <div class="project-card-art" aria-hidden="true">
                {p.image ? (
                  <img src={opt(p.image, 720)} alt={p.name} class="project-card-img" loading="lazy" decoding="async" width="720" height="360" />
                ) : (
                  <svg viewBox="0 0 64 64" width="56" height="56" fill="none" class="project-card-glyph">
                    <defs>
                      <linearGradient id={`g-${p.id}`} x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#FFFFFF"/>
                        <stop offset="60%" stop-color="#A1A1AA"/>
                        <stop offset="100%" stop-color="#52525B"/>
                      </linearGradient>
                    </defs>
                    <rect width="64" height="64" rx="12" fill="#0F0F18" stroke={`url(#g-${p.id})`} stroke-width="1.25" opacity="0.95"/>
                    <g stroke={`url(#g-${p.id})`} stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" fill="none" set:html={categoryIcon(p.category)}>
                    </g>
                  </svg>
                )}
                <span class="project-card-cat">{cat?.label || "Project"}</span>
                {p.featured && <span class="project-card-star" title="Featured">★</span>}
              </div>
              <div class="project-card-body">
                <h3 class="project-card-title">{p.name}</h3>
                {p.description && <p class="project-card-desc">{p.description}</p>}
                {p.tags.length > 0 && (
                  <div class="project-card-tags">
                    {p.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
                  </div>
                )}
                <div class="project-card-meta">
                  {p.url && <span class="meta-badge">Live</span>}
                  {p.github && <span class="meta-badge">Source</span>}
                  {p.stars != null && p.stars > 0 && <span class="meta-badge meta-badge-stars">★ {p.stars.toLocaleString()}</span>}
                  <span class="project-card-arrow">Read case study →</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 700px) { .projects-grid { grid-template-columns: repeat(2, 1fr); } }

  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-edge);
    background: linear-gradient(180deg, var(--color-card) 0%, var(--color-card-strong) 100%);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .project-card:hover {
    border-color: var(--color-edge-strong);
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -16px rgba(0, 0, 0, 0.4);
  }

  .project-card-art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 8;
    background:
      repeating-linear-gradient(
        315deg,
        rgba(255, 255, 255, 0.02) 0,
        rgba(255, 255, 255, 0.02) 1px,
        transparent 1px,
        transparent 10px
      ),
      var(--color-bg-2);
    border-bottom: 1px solid var(--color-edge);
    overflow: hidden;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .project-card-art {
      background:
        repeating-linear-gradient(315deg, rgba(0, 0, 0, 0.02) 0, rgba(0, 0, 0, 0.02) 1px, transparent 1px, transparent 10px),
        var(--color-bg-2);
    }
  }
  html[data-theme="light"] .project-card-art {
    background:
      repeating-linear-gradient(315deg, rgba(0, 0, 0, 0.02) 0, rgba(0, 0, 0, 0.02) 1px, transparent 1px, transparent 10px),
      var(--color-bg-2);
  }
  .project-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-card-cat {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.6);
    border: 1px solid var(--color-edge-strong);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    backdrop-filter: blur(4px);
  }
  .project-card-star {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    color: var(--color-fg);
    font-size: 0.9rem;
  }
  .project-card-glyph { opacity: 0.9; }

  .project-card-body { padding: 1.1rem 1.25rem 1.25rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .project-card-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    line-height: 1.3;
  }
  .project-card-desc {
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .project-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.3rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--color-edge);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
  }
  .meta-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-fg-subtle);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--color-edge);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
  }
  .meta-badge-stars { color: var(--color-accent-2); }
  .project-card-arrow {
    margin-left: auto;
    color: var(--color-fg-subtle);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .project-card:hover .project-card-arrow { transform: translateX(2px); color: var(--color-fg); }
</style>
