---
import { getDynamicConfig } from "../../lib/config";

const siteConfig = await getDynamicConfig();
const email = siteConfig.email || "";
---

<section id="contact" class="section">
  <div class="container-narrow">
    <div class="section-head reveal">
      <div>
        <p class="text-eyebrow">Contact</p>
        <h2 class="section-title">Let's build something useful</h2>
      </div>
    </div>

    <div class="panel p-6 sm:p-7 reveal reveal-delay-1">
      {siteConfig.contactBlurb && <p class="contact-blurb">{siteConfig.contactBlurb}</p>}

      {email ? (
        <a class="contact-mail" href={`mailto:${email}`}>
          <span class="contact-mail-label">Email</span>
          <span class="contact-mail-value">{email}</span>
          <span class="contact-mail-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <p class="italic text-sm text-[var(--color-fg-muted)]">No email configured yet.</p>
      )}

      {siteConfig.meetingUrl && (
        <a href={siteConfig.meetingUrl} target="_blank" rel="noopener noreferrer" class="contact-book btn btn-outline mt-5">
          Book a call
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}

      <div class="contact-links">
        {siteConfig.links?.github && (
          <a href={siteConfig.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        )}
        {siteConfig.links?.linkedin && (
          <a href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        )}
        {siteConfig.links?.twitter && (
          <a href={siteConfig.links.twitter} target="_blank" rel="noopener noreferrer">X</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-blurb {
    color: var(--color-fg-muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .contact-mail {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-edge);
    background: var(--color-bg-2);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }
  .contact-mail:hover { border-color: var(--color-edge-strong); }
  .contact-mail-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-subtle);
    flex-shrink: 0;
  }
  .contact-mail-value {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--color-fg);
    word-break: break-all;
  }
  .contact-mail-arrow {
    margin-left: auto;
    color: var(--color-fg-subtle);
    font-size: 1.1rem;
  }
  .contact-book { text-decoration: none; }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--color-edge);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-fg-subtle);
  }
  .contact-links a { transition: color 0.2s ease; }
  .contact-links a:hover { color: var(--color-fg); }
</style>
