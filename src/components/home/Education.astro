---
import { getEducation } from "../../lib/loaders";

interface Education {
  id: number;
  institution: string;
  degree: string;
  startDate: string;
  endDate?: string;
  details?: string;
}

const educationList = (await getEducation()) as Education[];


function formatDate(dateStr: string) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return "";
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---

{educationList.length > 0 && (
  <section class="section">
    <div class="container-narrow">
      <div class="section-head reveal">
        <div>
          <p class="text-eyebrow">Education</p>
          <h2 class="section-title">Background</h2>
        </div>
      </div>

      <div class="edu-grid">
        {educationList.map((edu) => (
          <article class="panel p-5 sm:p-6 reveal">
            <div class="edu-head">
              <div>
                <h3 class="edu-degree">{edu.degree}</h3>
                <p class="edu-school">{edu.institution}</p>
              </div>
              <time class="edu-dates">
                {formatDate(edu.startDate)} — {edu.endDate ? formatDate(edu.endDate) : "Present"}
              </time>
            </div>
            {edu.details && <p class="edu-details">{edu.details}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .edu-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .edu-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .edu-degree {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-fg);
  }
  .edu-school {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }
  .edu-dates {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    white-space: nowrap;
  }
  .edu-details {
    margin-top: 0.75rem;
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }
</style>
