---
import { getDynamicConfig } from "../../lib/config";
import { env } from "../../lib/env";

const siteConfig = await getDynamicConfig();
const author = siteConfig.author || env.siteName;
const shortBio = siteConfig.bio?.short || "";
const focusLabel = siteConfig.bio?.focusLabel || "Current directive";
const locationLine = [siteConfig.location, siteConfig.timezone]
  .filter(Boolean)
  .join(" · ");

const heroMetrics = siteConfig.heroMetrics || [];
const availability = siteConfig.bio?.availability || "";

const hostPart = (() => {
  try { return new URL(siteConfig.url).hostname.split(".")[0] || "swadhin"; }
  catch { return "swadhin"; }
})();
const terminalTitle = `guest@${hostPart}-desktop:~`;
const termLines = [
  siteConfig.bio?.currentFocus && { cmd: "current_focus", out: siteConfig.bio.currentFocus, emphasis: false },
  siteConfig.bio?.currentlyBuilding && { cmd: "currently_building", out: siteConfig.bio.currentlyBuilding, emphasis: false },
  siteConfig.bio?.seeking && { cmd: "seeking", out: siteConfig.bio.seeking, emphasis: true },
].filter(Boolean) as { cmd: string; out: string; emphasis: boolean }[];
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-portrait reveal">
      <div class="portrait-frame">
        <img src={siteConfig.profileImage || "/profile.jpg"} alt={author} class="portrait" loading="eager" decoding="async" fetchpriority="high" width="160" height="160" />
      </div>
    </div>

    <div class="hero-content reveal reveal-delay-1">
      <p class="hero-eyebrow">{focusLabel}</p>
      <h1 class="hero-name">{author}</h1>
      <div class="hero-status">
        {availability && (
          <span class="status-pill" aria-label="Availability">
            <span class="status-dot" aria-hidden="true"></span>
            {availability}
          </span>
        )}
        {locationLine && <span class="hero-location">{locationLine}</span>}
      </div>
      {shortBio && <p class="hero-tagline">{shortBio}</p>}

      <div class="hero-actions">
        <a href="/projects" class="btn btn-primary">
          View projects
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        {siteConfig.cvUrl && (
          <a href={siteConfig.cvUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download CV
          </a>
        )}
        {siteConfig.email && (
          <a href={`mailto:${siteConfig.email}`} class="btn btn-ghost">Email</a>
        )}
        {siteConfig.meetingUrl && (
          <a href={siteConfig.meetingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Book a call</a>
        )}
      </div>
    </div>
  </div>

  {heroMetrics.length > 0 && (
    <dl class="glance-grid reveal reveal-delay-2">
      {heroMetrics.map((m) => (
        <div class="glance-card">
          <dt class="glance-label">{m.label}</dt>
          <dd class="glance-value">{m.value}</dd>
          <dd class="glance-sub">{m.sub}</dd>
        </div>
      ))}
    </dl>
  )}

  {termLines.length > 0 && (
    <div class="terminal reveal reveal-delay-3" aria-label="Terminal">
      <div class="terminal-bar">
        <span class="terminal-dot" aria-hidden="true"></span>
        <span class="terminal-dot" aria-hidden="true"></span>
        <span class="terminal-dot" aria-hidden="true"></span>
        <span class="terminal-title">{terminalTitle}</span>
      </div>
      <div class="terminal-body">
        {termLines.map((line) => (
          <div class="term-line">
            <span class="term-prompt" aria-hidden="true">$</span> <span class="term-cmd">{line.cmd}</span>
            <div class:list={["term-out", line.emphasis && "term-out-emphasis"]}>{line.out}</div>
          </div>
        ))}
        <div class="term-line term-line-cursor" aria-hidden="true">
          <span class="term-prompt">$</span> <span class="term-cursor"></span>
        </div>
      </div>
    </div>
  )}
</section>

<style>
  .hero { padding: 0.5rem 0 1rem; }

  .hero-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 2.5rem;
  }
  @media (max-width: 720px) {
    .hero-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  /* Portrait */
  .hero-portrait { display: flex; justify-content: flex-start; }
  .portrait-frame {
    position: relative;
    width: 156px;
    height: 156px;
    flex-shrink: 0;
  }
  @media (max-width: 720px) {
    .portrait-frame { width: 112px; height: 112px; }
  }
  .portrait {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    object-fit: cover;
    background: var(--color-card-strong);
    border: 1px solid var(--color-edge-strong);
    filter: grayscale(1) contrast(1.03);
    transition: filter 0.4s ease;
  }
  .portrait:hover { filter: grayscale(0) contrast(1); }

  /* Hero text */
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .hero-name {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5vw, 3.65rem);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--color-fg);
    text-wrap: balance;
  }
  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }
  .hero-location {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    letter-spacing: 0.03em;
  }
  .status-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--color-fg);
    animation: status-pulse 2s ease-in-out infinite;
  }

  .hero-tagline {
    margin-top: 1.25rem;
    max-width: 58ch;
    color: var(--color-fg-muted);
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    font-weight: 450;
    line-height: 1.55;
    letter-spacing: -0.005em;
  }

  /* Buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  /* At a Glance — compact stat strip */
  .glance-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-edge);
  }
  @media (min-width: 720px) { .glance-grid { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); } }
  .glance-card {
    padding: 0 1.1rem 1.1rem 0;
  }
  @media (min-width: 720px) {
    .glance-card { border-left: 1px solid var(--color-edge); padding-left: 1.5rem; padding-right: 1.5rem; }
    .glance-card:first-child { border-left: 0; padding-left: 0; }
  }
  .glance-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }
  .glance-value {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    font-weight: 800;
    color: var(--color-fg);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .glance-sub {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    line-height: 1.45;
    max-width: 24ch;
  }

  /* Terminal card */
  .terminal {
    margin-top: 2rem;
    border: 1px solid var(--color-edge);
    background: var(--color-bg-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    background: var(--color-card-strong);
    border-bottom: 1px solid var(--color-edge);
  }
  .terminal-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--color-edge-strong);
  }
  .terminal-title {
    margin-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-subtle);
  }
  .terminal-body {
    padding: 1.1rem 1.15rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }
  .term-line + .term-line { margin-top: 1.1rem; }
  .term-line-cursor { margin-top: 1.1rem; }
  .term-prompt { color: var(--color-fg-subtle); font-weight: 600; margin-right: 0.35rem; }
  .term-cmd { color: var(--color-fg); font-weight: 600; }
  .term-out { margin-top: 0.3rem; color: var(--color-fg-muted); }
  .term-out-emphasis { margin-top: 0.3rem; color: var(--color-fg); font-weight: 500; }
  .term-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    background: var(--color-fg-muted);
    vertical-align: text-bottom;
    margin-left: 0.1rem;
    animation: term-blink 1.1s steps(1) infinite;
  }
  @keyframes term-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .term-cursor { animation: none; opacity: 1; }
  }
</style>
