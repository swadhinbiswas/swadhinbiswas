---
import { getDynamicConfig } from "../../lib/config";
import { env } from "../../lib/env";

const siteConfig = await getDynamicConfig();
const year = new Date().getFullYear();
const author = siteConfig.author || env.siteName;
const socials = (siteConfig.socials || []).filter((s) =>
  ["github", "linkedin", "twitter", "scholar", "email", "youtube"].includes(s.icon)
);
const links = [
  siteConfig.links?.github ? { label: "GitHub", href: siteConfig.links.github } : null,
  siteConfig.links?.linkedin ? { label: "LinkedIn", href: siteConfig.links.linkedin } : null,
  siteConfig.links?.twitter ? { label: "X", href: siteConfig.links.twitter } : null,
  siteConfig.email ? { label: "Email", href: `mailto:${siteConfig.email}` } : null,
].filter(Boolean) as { label: string; href: string }[];

const resolvedLinks = links.length > 0
  ? links
  : socials.map((s) => ({ label: s.name, href: s.url }));
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-meta">
      <p class="footer-copyright">© {year} {author}</p>
      {siteConfig.footerTagline && <p class="footer-tagline">{siteConfig.footerTagline}</p>}
    </div>
    {resolvedLinks.length > 0 && (
      <nav class="footer-nav" aria-label="Footer">
        {resolvedLinks.map((s) => (
          <a
            href={s.href}
            target={s.href.startsWith("http") ? "_blank" : undefined}
            rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="footer-link"
          >
            {s.label}
          </a>
        ))}
      </nav>
    )}
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-edge);
    padding: 2rem 1.5rem;
    margin-top: 4rem;
  }
  .footer-inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .footer-copyright {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    letter-spacing: 0.03em;
  }
  .footer-tagline {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-fg-subtle);
    opacity: 0.75;
  }
  .footer-nav { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .footer-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-link:hover { color: var(--color-fg); }
</style>
