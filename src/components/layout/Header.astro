---
import { getDynamicConfig } from "../../lib/config";

const siteConfig = await getDynamicConfig();
const pathname = Astro.url.pathname;
const author = siteConfig.author || "Swadhin Biswas";

const nameParts = author.split(" ");
const initials = nameParts.map((p) => p[0]).join("").slice(0, 2).toUpperCase();
const role = siteConfig.bio?.intro || "Data / Backend Engineer";

const rawNav = siteConfig.navItems || [];
const rawCreative = siteConfig.creativeNavItems || [];

const defaultNav = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Experience", href: "/experience" },
  { label: "Skills", href: "/skills" },
  { label: "Projects", href: "/projects" },
  { label: "Achievements", href: "/achievements" },
  { label: "Research", href: "/research" },
  { label: "Writing", href: "/posts" },
  { label: "Contact", href: "/contact" },
];

const defaultCreative = [
  { label: "Bookshelf", href: "/books" },
  { label: "Explore", href: "/explore" },
];

function getIcon(href: string, label: string): string {
  if (href === "/") return "home";
  if (href.startsWith("/about")) return "user";
  if (href.startsWith("/experience")) return "briefcase";
  if (/skill/i.test(href)) return "code";
  if (href.startsWith("/project")) return "folder";
  if (href.startsWith("/achievement")) return "award";
  if (href.startsWith("/researc")) return "flask";
  if (/(post|blog|writing)/i.test(href)) return "book-open";
  if (/(book|reading|shelf)/i.test(href) || /(book|reading|shelf)/i.test(label)) return "book-open";
  if (href.startsWith("/contact")) return "mail";
  if (/(explore|gallery|photo|creative)/i.test(href) || /(explore|gallery)/i.test(label)) return "compass";
  return "link";
}

const navItems = (rawNav.length > 0 ? rawNav : defaultNav).map((item) => ({
  ...item,
  icon: getIcon(item.href, item.label),
}));

const creativeItems = (rawCreative.length > 0 ? rawCreative : defaultCreative).map((item) => ({
  ...item,
  icon: getIcon(item.href, item.label),
}));

const socials = [
  siteConfig.links?.github ? { label: "GitHub", href: siteConfig.links.github, icon: "github" } : null,
  siteConfig.links?.linkedin ? { label: "LinkedIn", href: siteConfig.links.linkedin, icon: "linkedin" } : null,
  siteConfig.links?.twitter ? { label: "Twitter", href: siteConfig.links.twitter, icon: "twitter" } : null,
  siteConfig.links?.youtube ? { label: "YouTube", href: siteConfig.links.youtube, icon: "youtube" } : null,
  siteConfig.email ? { label: "Email", href: `mailto:${siteConfig.email}`, icon: "mail" } : null,
].filter(Boolean) as { label: string; href: string; icon: string }[];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<aside class="shell-sidebar" data-open="false">
  <div class="sidebar-header">
    <a href="/" class="brand" aria-label={`${author} home`}>
      <span class="brand-mark" aria-hidden="true">{initials}</span>
      <span class="brand-text">
        <strong>{author}</strong>
        <span>{role}</span>
      </span>
    </a>
    <button class="mobile-menu-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="sidebar-nav" data-menu-toggle>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav" id="sidebar-nav" aria-label="Primary navigation">
    <p class="nav-section-title nav-first">Menu</p>
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={["nav-item", isActive(item.href) && "active"]}
        aria-current={isActive(item.href) ? "page" : undefined}
      >
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {item.icon === "home" && <><path d="M3 12 12 3l9 9"/><path d="M5 10v10h14V10"/></>}
          {item.icon === "user" && <><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></>}
          {item.icon === "briefcase" && <><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></>}
          {item.icon === "code" && <><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></>}
          {item.icon === "folder" && <><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></>}
          {item.icon === "award" && <><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></>}
          {item.icon === "flask" && <><path d="M9 3h6"/><path d="M10 3v6L4 19a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-6-10V3"/><path d="M7 14h10"/></>}
          {item.icon === "book-open" && <><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></>}
          {item.icon === "mail" && <><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></>}
          {item.icon === "compass" && <><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></>}
          {item.icon === "wrench" && <><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></>}
          {item.icon === "link" && <><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></>}
        </svg>
        <span>{item.label}</span>
      </a>
    ))}

    {creativeItems.length > 0 && (
      <>
        <p class="nav-section-title">Craft</p>
        {creativeItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-item", isActive(item.href) && "active"]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {item.icon === "book-open" && <><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></>}
              {item.icon === "compass" && <><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></>}
              {item.icon === "wrench" && <><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></>}
              {item.icon === "link" && <><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></>}
            </svg>
            <span>{item.label}</span>
          </a>
        ))}
      </>
    )}

    {socials.length > 0 && (
      <>
        <p class="nav-section-title">Elsewhere</p>
        {socials.map((s) => (
          <a href={s.href} target={s.href.startsWith("http") ? "_blank" : undefined} rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined} class="nav-item">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {s.icon === "github" && <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>}
              {s.icon === "linkedin" && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></>}
              {s.icon === "twitter" && <path d="M22 4.01c-1 .49-1.98.689-3 .99-1.121-1.265-2.783-1.335-4.38-.737S11.977 6.323 12 8v1c-3.245.083-6.135-1.395-8-4 0 0-4.182 7.433 4 11-1.872 1.247-3.739 2.088-6 2 3.308 1.803 6.913 2.423 10.034 1.517 3.58-1.04 6.522-3.723 7.651-7.742a13.84 13.84 0 0 0 .497-3.753C20.18 7.773 21.692 5.25 22 4.009z"/>}
              {s.icon === "youtube" && <><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></>}
              {s.icon === "mail" && <><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></>}
            </svg>
            <span>{s.label}</span>
          </a>
        ))}
      </>
    )}
  </nav>

  <div class="sidebar-footer">
    {siteConfig.bio?.availability && (
      <span class="sidebar-status">
        <span class="sidebar-status-dot" aria-hidden="true"></span>
        {siteConfig.bio.availability}
      </span>
    )}
    {siteConfig.sidebarTagline && <p class="sidebar-tagline">{siteConfig.sidebarTagline}</p>}
    <button type="button" class="theme-toggle" aria-label="Toggle dark mode" data-theme-toggle>
      <svg class="theme-icon theme-icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <svg class="theme-icon theme-icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <span class="theme-toggle-label" data-theme-label>Dark</span>
    </button>
  </div>
</aside>

<script>
  const init = () => {
    const sidebar = document.querySelector<HTMLElement>(".shell-sidebar");
    const btn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    btn?.addEventListener("click", () => {
      const open = sidebar?.getAttribute("data-open") === "true";
      sidebar?.setAttribute("data-open", open ? "false" : "true");
      btn.setAttribute("aria-expanded", open ? "false" : "true");
    });

    const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const themeLabel = document.querySelector<HTMLSpanElement>("[data-theme-label]");
    const applyTheme = (t: string) => {
      document.documentElement.setAttribute("data-theme", t);
      try { localStorage.setItem("theme", t); } catch {}
      if (themeLabel) themeLabel.textContent = t === "dark" ? "Dark" : "Light";
      if (themeBtn) themeBtn.setAttribute("aria-label", t === "dark" ? "Switch to light mode" : "Switch to dark mode");
    };
    themeBtn?.addEventListener("click", () => {
      const cur = document.documentElement.getAttribute("data-theme")
        || (window.matchMedia?.("(prefers-color-scheme: light)").matches ? "light" : "dark");
      applyTheme(cur === "dark" ? "light" : "dark");
    });
    const resolved = document.documentElement.getAttribute("data-theme")
      || (window.matchMedia?.("(prefers-color-scheme: light)").matches ? "light" : "dark");
    if (themeLabel) themeLabel.textContent = resolved === "dark" ? "Dark" : "Light";
    if (themeBtn) themeBtn.setAttribute("aria-label", resolved === "dark" ? "Switch to light mode" : "Switch to dark mode");
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .sidebar-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1.25rem 1.1rem;
    border-bottom: 1px solid var(--color-edge);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: 1;
    min-width: 0;
    color: var(--color-fg);
    text-decoration: none;
  }
  .brand-mark {
    display: inline-flex;
    width: 2.3rem;
    height: 2.3rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    background: var(--color-fg);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .brand-text { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .brand-text span {
    margin-top: 0.12rem;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-menu-toggle {
    display: none;
    width: 2.1rem;
    height: 2.1rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius);
    background: var(--color-card);
    color: var(--color-fg);
    transition: all 0.2s ease;
  }
  .mobile-menu-toggle:hover { border-color: var(--color-fg); }

  .sidebar-nav { flex: 1; padding: 0.75rem 0 1rem; }
  .nav-first { margin-top: 0; }

  .sidebar-footer {
    padding: 1rem 1.1rem;
    border-top: 1px solid var(--color-edge);
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .sidebar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-edge);
    border-radius: 999px;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.62rem;
  }
  .sidebar-status-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-fg);
    animation: status-pulse 2s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  .sidebar-tagline { opacity: 0.8; }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius);
    background: var(--color-card);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .theme-toggle:hover {
    border-color: var(--color-fg);
    color: var(--color-fg);
  }
  .theme-icon-moon { display: none; }
  html[data-theme="light"] .theme-icon-moon { display: block; }
  html[data-theme="light"] .theme-icon-sun { display: none; }
  @media (prefers-color-scheme: light) {
    html:not([data-theme]) .theme-icon-moon { display: block; }
    html:not([data-theme]) .theme-icon-sun { display: none; }
  }

  @media (max-width: 768px) {
    .mobile-menu-toggle { display: inline-flex; }
    .sidebar-header { padding: 1rem; }
  }
</style>
