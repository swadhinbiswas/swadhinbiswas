---
import "../styles/global.css";
import { getDynamicConfig } from "../lib/config";
import { env } from "../lib/env";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
  canonical?: string;
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  keywords?: string[];
  themeColor?: string;
}

const {
  title,
  description,
  image,
  ogType,
  noindex = false,
  canonical,
  publishedTime,
  modifiedTime,
  authorName,
  keywords,
  themeColor = "#0A0A12",
} = Astro.props;

const [siteConfig, eduPromise, certPromise] = await Promise.all([
  getDynamicConfig(),
  import("../lib/loaders").then(({ getEducation }) => getEducation().catch(() => [])),
  import("../lib/loaders").then(({ getCertifications }) => getCertifications().catch(() => [])),
]);

const author = authorName || siteConfig.author || env.siteName;
const fullTitle = title
  ? `${title} — ${author}`
  : `${author} — Portfolio, Engineering & Writing`;
const pageDescription =
  description || siteConfig.description || env.siteDescription;
const ogImage = image || `${siteConfig.url || env.siteUrl}/og-image.png`;
const canonicalURL = new URL(
  canonical || Astro.url.pathname,
  siteConfig.url || env.siteUrl,
).toString();

const kw = (keywords && keywords.length > 0
  ? keywords
  : siteConfig.seo?.keywords || []
).join(", ");

const sameAs: string[] = [
  siteConfig.links?.github,
  siteConfig.links?.linkedin,
  siteConfig.links?.twitter,
  siteConfig.links?.youtube,
  ...(siteConfig.socials || []).map((s) => s.url),
].filter((u): u is string => Boolean(u)).filter((u, i, arr) => arr.indexOf(u) === i);

const siteUrl = (siteConfig.url || env.siteUrl || "https://swadhin.cv").replace(/\/$/, "");

let alumniOf: unknown[] = [];
try {
  const eduRows = await eduPromise;
  alumniOf = eduRows.map((e: any) => ({
    "@type": "CollegeOrUniversity",
    name: e.institution,
  }));
} catch {}

let credentials: unknown[] = [];
try {
  const certRows = await certPromise;
  credentials = certRows.map((c: any) => ({
    "@type": "EducationalOccupationalCredential",
    name: c.name,
    ...(c.url ? { url: c.url } : {}),
    ...(c.issuer ? { issuingAuthority: { "@type": "Organization", name: c.issuer } } : {}),
    ...(c.year ? { dateIssued: c.year } : {}),
  }));
} catch {}
// Single source-of-truth Person entity — referenced by @id across the site.
// This is what Google merges to build the Knowledge Panel.
const personSchema = {
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  name: author,
  givenName: "Swadhin",
  familyName: "Biswas",
  alternateName: ["Swadhin", "Swadhin Biswas", "স্বাধীন বিশ্বাস"],
  url: `${siteUrl}/`,
  image: {
    "@type": "ImageObject",
    url: `${siteUrl}/profile.jpg`,
    caption: author,
  },
  description: siteConfig.bio?.short || pageDescription,
  jobTitle: siteConfig.bio?.intro || "Data / Backend Engineer",
  email: siteConfig.email ? `mailto:${siteConfig.email}` : undefined,
  address: siteConfig.seo?.location?.city
    ? {
        "@type": "PostalAddress",
        addressLocality: siteConfig.seo.location.city,
        addressCountry: siteConfig.seo.location.country || undefined,
      }
    : undefined,
  sameAs,
  knowsAbout: [
    "Data Engineering",
    "Backend Engineering",
    "Machine Learning",
    "MLOps",
    "Distributed Systems",
    "Python",
    "TypeScript",
    ...(siteConfig.skills || []).map((s) => s.name),
  ].filter(Boolean),
  knowsLanguage: [
    { "@type": "Language", name: "English" },
    { "@type": "Language", name: "Bengali" },
  ],
  ...(siteConfig.seo?.worksFor?.name
    ? { worksFor: { "@type": "Organization", name: siteConfig.seo.worksFor.name, url: siteConfig.seo.worksFor.url || undefined } }
    : {}),
  mainEntityOfPage: canonicalURL,
  ...(alumniOf.length > 0 ? { alumniOf } : {}),
  ...(credentials.length > 0 ? { hasCredential: credentials } : {}),
};


const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: author,
      description: siteConfig.description || pageDescription,
      inLanguage: "en-US",
      publisher: { "@id": `${siteUrl}/#person` },
      author: { "@id": `${siteUrl}/#person` },
    },
    personSchema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColor} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAFAFA" media="(prefers-color-scheme: light)" />

    <!-- Theme bootstrap — set data-theme before first paint to avoid FOUC -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    {kw && <meta name="keywords" content={kw} />}
    <meta name="author" content={author} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1"} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon set -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content={themeColor} />
    <meta name="application-name" content={author} />
    <meta name="apple-mobile-web-app-title" content={author} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="mask-icon" href="/favicon.svg" color="#000000" />

    <!-- Preload self-hosted fonts (single variable font for the entire weight range) -->
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preload LCP image (hero avatar) on pages that have it -->
    <link rel="preload" href="/profile.jpg" as="image" type="image/jpeg" />

    <!-- Feeds -->
    <link rel="alternate" type="application/rss+xml" title={`${author} — RSS`} href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${author} — Google News`} href="/google-news.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType || "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={author} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {siteConfig.links?.twitter && (
      <meta name="twitter:creator" content={"@" + (siteConfig.links.twitter.split("/").pop() || "")} />
    )}
    {siteConfig.links?.twitter && (
      <meta name="twitter:site" content={"@" + (siteConfig.links.twitter.split("/").pop() || "")} />
    )}

    <!-- Crawler hints -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="x-dns-prefetch-control" content="on" />
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="//github.com" />
    <link rel="dns-prefetch" href="//thesvg.org" />

    <!-- Deferred analytics — script tag is a no-op shell, GA is loaded only after idle -->
    <script is:inline define:vars={{ GA_ID: env.gaId }}>
      window.__deferGA = function () {
        if (!GA_ID || window.__gaLoaded) return;
        window.__gaLoaded = true;
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", GA_ID, { transport_type: "beacon", anonymize_ip: true });
      };
      window.addEventListener("load", function () {
        ("requestIdleCallback" in window)
          ? window.requestIdleCallback(window.__deferGA, { timeout: 4000 })
          : setTimeout(window.__deferGA, 3000);
      });
    </script>

    <slot name="head" />

    <!-- Person / Knowledge Panel JSON-LD (merged with page-level @graph) -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-[var(--color-accent)] focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to content
    </a>

    <button
      type="button"
      class="back-to-top"
      aria-label="Back to top"
      data-back-to-top
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <div class="shell">
      <Header />
      <div class="shell-main">
        <main id="main" class="shell-content">
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
      );
      const init = () => document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
      else init();
      document.addEventListener("astro:page-load", init);

      const backToTop = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
      const onScroll = () => {
        if (!backToTop) return;
        if (window.scrollY > 600) backToTop.classList.add("visible");
        else backToTop.classList.remove("visible");
      };
      backToTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
